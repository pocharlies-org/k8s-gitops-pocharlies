+    if p["status"] != "ok" and (p["changes_required"] or p["possible_security_issue"]
+                                or p["merge_recommendation"] != "unknown"):
+        errs.append("con status != ok no hay recomendación ni etiquetas (una review caída no bloquea nada)")
+    return errs
