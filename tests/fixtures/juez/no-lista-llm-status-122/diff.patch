@@ -0,0 +1,68 @@
+import XCTest
+import DGXKit
+
+// DGX-782 H2-b3, criterio C4: la barra lateral de DGX Spark lista sus 11 secciones y la de Routing
+// sus 6, en horizontal y en vertical, y cada fila abre su pantalla. Se corre en iPad Pro 13 (iOS 26),
+// en iPad con iPadOS 17 (el simulador de 17.5) y, con DGX_LEGACY=1, la rama de iPadOS 17 forzada en
+// el moderno. Identificadores: `fila.ID` la fila, `seccion.ID` la pantalla, `barra.PESTAÑA` la barra.
+final class NavegacionUITests: XCTestCase {
+    override func setUp() { continueAfterFailure = false }
+
+    func testBarraLateralConTodasLasSecciones() throws {
+        try XCTSkipUnless(esIPad, "la barra lateral es del iPad")
+        let inferencia = NavSecciones.secciones(.inferencia).map(\.id)
+        let routing = NavSecciones.secciones(.routing).map(\.id)
+        XCTAssertEqual(inferencia.count, 11)
+        XCTAssertEqual(routing.count, 6)
+
+        for o in Orientacion.allCases {
+            XCUIDevice.shared.orientation = o.dispositivo
+            let app = lanzar(tab: NavPestana.inferencia.segmento)
+            recorrer(app, secciones: inferencia, barra: "barra.inferencia", vertical: o == .vertical)
+
+            // El enlace «Cuentas y cuotas» de la barra lleva a la pestaña Routing.
+            abrirBarra(app, vertical: o == .vertical)
+            esperar(elemento(app, "fila.otra-pestana"), "fila.otra-pestana")
+            elemento(app, "fila.otra-pestana").tap()
+            recorrer(app, secciones: routing, barra: "barra.routing", vertical: o == .vertical)
+        }
+    }
+
+    /// Abre una a una las filas de la barra y comprueba que llega a la pantalla de cada sección.
+    private func recorrer(_ app: XCUIApplication, secciones: [String], barra: String, vertical: Bool) {
+        abrirBarra(app, vertical: vertical)
+        esperar(elemento(app, barra), barra)
+        // Todas las filas están en la barra antes de abrir ninguna: sin desplazarla (caben las 11 en un iPad).
+        for id in secciones {
+            let fila = elemento(app, "fila.\(id)")
+            esperar(fila, "fila.\(id)")
+            if !fila.isHittable { volcarJerarquia(app, "fila.\(id) no tocable") }
+            XCTAssertTrue(fila.isHittable, "fila.\(id) existe pero no está a la vista sin desplazar la barra (frame \(fila.frame))")
+            XCTAssertGreaterThanOrEqual(fila.frame.height, 44, "fila.\(id) mide menos de 44 pt (accesibilidad)")
+        }
+        for id in secciones {
+            abrirBarra(app, vertical: vertical)
+            let fila = elemento(app, "fila.\(id)")
+            esperar(fila, "fila.\(id)")
+            traerALaVista(fila, en: elemento(app, barra))
+            fila.tap()
+            esperar(elemento(app, "seccion.\(id)"), "seccion.\(id)")
+        }
+    }
+
+    /// Con la barra más corta que sus filas (Dynamic Type grande), se desplaza hasta la fila.
+    private func traerALaVista(_ fila: XCUIElement, en barra: XCUIElement) {
+        var intentos = 0
+        while !fila.isHittable && intentos < 6 { barra.swipeUp(); intentos += 1 }
+    }
+
+    /// En vertical la barra está plegada y «Secciones» la abre; en horizontal está fija. Si ya está
+    /// a la vista (la barra se queda abierta tras elegir en algunos tamaños), no se toca.
+    private func abrirBarra(_ app: XCUIApplication, vertical: Bool) {
+        guard vertical else { return }
+        let fila = elemento(app, "ordenar")      // «Ordenar» solo existe con la barra abierta
+        if fila.exists && fila.isHittable { return }
+        let boton = app.buttons["secciones.abrir"].firstMatch
+        if boton.waitForExistence(timeout: 8) { boton.tap() }
+    }
+}
