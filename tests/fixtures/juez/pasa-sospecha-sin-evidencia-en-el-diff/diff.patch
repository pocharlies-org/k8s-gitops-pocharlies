+#!/usr/bin/env python3
+"""Lista las PRs sin actividad desde hace N dias (SC-9006)."""
+from datetime import timedelta
+
+
+def viejas(prs, ahora, dias):
+    """Las PRs cuyo `updatedAt` (datetime) es anterior a `ahora - dias`, en el orden de entrada."""
+    limite = ahora - timedelta(days=dias)
+    return [pr for pr in prs if pr.get('updatedAt') is not None and pr['updatedAt'] < limite]
diff --git a/tests/test_stale_prs.py b/tests/test_stale_prs.py
