--- /dev/null
+++ b/tests/test_stale_prs.py
@@ -0,0 +1,28 @@
+import importlib.util
+import unittest
+from datetime import datetime, timedelta
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+spec = importlib.util.spec_from_file_location('stale_prs', ROOT / 'scripts/stale-prs.py')
+stale = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(stale)
+
+AHORA = datetime(2026, 10, 9, 12, 0)
+
+
+class TestViejas(unittest.TestCase):
+    def test_el_limite_exacto_no_es_vieja(self):
+        justo = {'number': 1, 'updatedAt': AHORA - timedelta(days=14)}
+        vieja = {'number': 2, 'updatedAt': AHORA - timedelta(days=14, seconds=1)}
+        self.assertEqual(stale.viejas([justo, vieja], AHORA, 14), [vieja])
+
+    def test_una_pr_sin_updated_at_se_ignora(self):
+        self.assertEqual(stale.viejas([{'number': 3}, {'number': 4, 'updatedAt': None}], AHORA, 14), [])
+
+    def test_sin_prs_no_hay_viejas(self):
+        self.assertEqual(stale.viejas([], AHORA, 14), [])
+
+
+if __name__ == '__main__':
+    unittest.main()
