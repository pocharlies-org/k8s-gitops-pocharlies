+# --- DGX-820 (C2): el modo k64 ---
+OVERLAY_K64 = ROOT / "overlays/glm53-tp3-ventana-k64-20261010"
+LINEA_COMMIT = "66a7553"  # el head de pin/glm53-ventana-20261010 del que sale la rama de DGX-820 (DGX-818, #164)
+GIB = 2**30
+# El ConfigMap del modo k64 de main sin el KV: lo que el modo cambia ademas del tamano de pagina (DRIVER_VERSION lo lee check-host con REQUIRE_DISPRAM=1).
+MODO_K64 = {"KV_CACHE_MEMORY": MODO_K4["KV_CACHE_MEMORY"], "EXPECT_PAGESIZE": "65536", "REQUIRE_DISPRAM": "1",
+            "DRIVER_VERSION": "610.57.04", "PYTHONPATH": "/opt/dispram"}
+# S-1: el directorio en solo lectura y el socket aparte en rw; el plugin de python en ro (main: HOSTPATHS_K64).
+DISPRAM_HOSTPATHS = {"/run/dispram": "ro", "/run/dispram/dispram.sock": "rw", "/opt/kindling/dispram/python": "ro"}
+
+
+def sin_modo_ni_dispram(objs):
+    """El render sin lo unico que cambia del k4 al k64: el ConfigMap del modo (y su hash en los nombres) y los volumenes y montajes de dispram."""
+    out = {}
+    for (kind, ns, name), obj in objs.items():
+        if kind == "ConfigMap" and sin_hash(name) == "glm53-tp3-mode":
+            continue
+        obj = copy.deepcopy(obj)
+        if kind == "Deployment":
+            spec = obj["spec"]["template"]["spec"]
+            spec["volumes"] = [v for v in spec["volumes"] if not v["name"].startswith("dispram-")]
+            for c in spec["containers"] + spec["initContainers"]:
+                if "volumeMounts" in c:
+                    c["volumeMounts"] = [m for m in c["volumeMounts"] if not m["name"].startswith("dispram-")]
+        out[(kind, ns, name)] = json.loads(re.sub(r"glm53-tp3-mode-[a-z0-9]{10}", "glm53-tp3-mode", json.dumps(obj)))
+    return out
+
+
+def render_en(commit, path):
+    """El render de `path` tal como estaba en `commit` (git archive de k8s y overlays); None si el commit no esta en el clon."""
+    if subprocess.run(["git", "cat-file", "-e", f"{commit}^{{commit}}"], cwd=ROOT, capture_output=True).returncode:
+        return None
+    with tempfile.TemporaryDirectory() as tmp:
+        tar = subprocess.run(["git", "archive", commit, "k8s", "overlays"], cwd=ROOT, check=True, capture_output=True).stdout
+        subprocess.run(["tar", "-x", "-C", tmp], input=tar, check=True)
+        out = subprocess.run(["kubectl", "kustomize", f"{tmp}/{path.relative_to(ROOT)}"], check=True, capture_output=True, text=True).stdout
+    return [d for d in yaml.safe_load_all(out) if d]
+
+
+def montajes(c):
+    return {m["mountPath"]: m for m in c.get("volumeMounts", [])}
+
+
+def pod(dep):
+    return dep["spec"]["template"]["spec"]
+
+
+class ModoK64Test(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.objs = ventana.render(OVERLAY_K64)
+        cls.k4 = ventana.render(OVERLAY)
+
+    def test_tres_rangos_de_glm_con_replicas_1(self):
+        deps = {n for (kind, _, n) in self.objs if kind == "Deployment" and n.startswith("glm53-")}
+        self.assertEqual(deps, set(RANGOS))
+        for n, dep in rangos(self.objs).items():
+            with self.subTest(n=n):
+                self.assertEqual(dep["spec"]["replicas"], 1)
+                self.assertEqual(pod(dep)["nodeSelector"]["kubernetes.io/hostname"], RANGOS[n][0])
+
+    def test_modo_k64_con_el_kv_del_k4_de_la_ventana(self):
+        self.assertEqual(cm_data(self.objs, "glm53-tp3-mode"), MODO_K64)
+        for n, dep in rangos(self.objs).items():
+            e = efectivo(self.objs, dep)
+            self.assertEqual({k: e[k] for k in MODO_K64}, MODO_K64, n)
+        # Nunca mas de lo que el k4 de la ventana dejo sin problemas: 12 GiB (los 18 de main solo valen con los +2 de dispram sin medir aqui).
+        self.assertEqual(int(MODO_K64["KV_CACHE_MEMORY"]), 12 * GIB)
+
+    def test_los_tres_rangos_comparten_el_mismo_configmap_del_modo(self):
+        # La receta exige reiniciar los tres rangos juntos: el modo va con hash y los tres lo usan (cambiar el KV cambia la plantilla de los tres).
+        modos = [n for (kind, _, n) in self.objs if kind == "ConfigMap" and sin_hash(n) == "glm53-tp3-mode"]
+        self.assertEqual(len(modos), 1, modos)
+        for n, dep in rangos(self.objs).items():
+            with self.subTest(n=n):
+                self.assertEqual(dep["spec"]["strategy"], {"type": "Recreate"})
+                refs = {r["configMapRef"]["name"] for c in pod(dep)["containers"] + pod(dep)["initContainers"]
+                        for r in c.get("envFrom", []) if sin_hash(r["configMapRef"]["name"]) == "glm53-tp3-mode"}
+                self.assertEqual(refs, set(modos))
+
+    def test_la_receta_nccl_es_la_del_k4_en_los_tres_rangos(self):
+        # Entorno efectivo de vllm: el del k4 mas lo que trae el modo k64 (y el KV, que es el mismo literal): ni un NCCL_*, ni MENTAT_*, ni ARX distinto.
+        for n, dep in rangos(self.objs).items():
+            with self.subTest(n=n):
+                e, e4 = efectivo(self.objs, dep), efectivo(self.k4, self.k4[("Deployment", "llm", n)])
+                self.assertEqual({k: v for k, v in e.items() if k not in MODO_K64}, {k: v for k, v in e4.items() if k not in MODO_K64})
+                self.assertEqual(e["NCCL_RUNTIME_CONNECT"], "1")
+                self.assertEqual(e["LD_PRELOAD"], ventana.sonda().LIB_PARCHEADA)
+                self.assertEqual(e["MENTAT_FABRIC_IP"], LAN[RANGOS[n][1]])
+                self.assertEqual(vllm(dep)["command"], ["bash", "/opt/nccl-ring-start/start.sh"])
+
+    def test_el_arranque_es_el_script_del_k4(self):
+        self.assertEqual(cm_data(self.objs, "glm53-tp3-nccl-ring"), cm_data(self.k4, "glm53-tp3-nccl-ring"))
+
+    def test_el_render_es_el_del_k4_salvo_el_modo_y_dispram(self):
+        self.assertEqual(sin_modo_ni_dispram(self.objs), sin_modo_ni_dispram(self.k4))
+
+    def test_s1_dispram_directorio_ro_y_socket_aparte(self):
+        for n, dep in rangos(self.objs).items():
+            with self.subTest(n=n):
+                spec = pod(dep)
+                vols = {v["name"]: v["hostPath"] for v in spec["volumes"] if "hostPath" in v}
+                por_ruta = {h["path"]: nombre for nombre, h in vols.items()}
+                self.assertTrue(set(DISPRAM_HOSTPATHS) <= set(por_ruta))
+                self.assertNotIn("type", vols[por_ruta["/run/dispram/dispram.sock"]], "el socket va sin type: connect no crea nada en el host")
+                for c in (vllm(dep), next(c for c in spec["initContainers"] if c["name"] == "check-host")):
+                    m = montajes(c)
+                    self.assertEqual(m["/run/dispram"]["name"], por_ruta["/run/dispram"])
+                    self.assertTrue(m["/run/dispram"]["readOnly"], c["name"])
+                    self.assertEqual(m["/run/dispram/dispram.sock"]["name"], por_ruta["/run/dispram/dispram.sock"])
+                    self.assertFalse(m["/run/dispram/dispram.sock"].get("readOnly", False), c["name"])
+                m = montajes(vllm(dep))["/opt/dispram"]
+                self.assertEqual((m["name"], m["readOnly"]), (por_ruta["/opt/kindling/dispram/python"], True))
+                self.assertEqual(efectivo(self.objs, dep)["PYTHONPATH"], "/opt/dispram")
+
+    def test_lista_cerrada_de_hostpath_la_del_k4_mas_dispram(self):
+        for n, dep in rangos(self.objs).items():
+            with self.subTest(n=n):
+                def rutas(d):
+                    vols = {v["name"]: v["hostPath"]["path"] for v in pod(d)["volumes"] if "hostPath" in v}
+                    acceso = {}
+                    for c in pod(d)["containers"] + pod(d)["initContainers"]:
+                        for m in c.get("volumeMounts", []):
+                            if m["name"] in vols:
+                                acceso.setdefault(vols[m["name"]], set()).add("ro" if m.get("readOnly") else "rw")
+                    return acceso
+                antes, ahora = rutas(self.k4[("Deployment", "llm", n)]), rutas(dep)
+                self.assertEqual(ahora, {**antes, **{p: {a} for p, a in DISPRAM_HOSTPATHS.items()}})
+
+    def test_s2_solo_los_tres_rangos_de_glm_montan_dispram(self):
+        for (kind, _, n), obj in self.objs.items():
+            if kind in ("Deployment", "StatefulSet", "DaemonSet", "Job", "CronJob") and n not in RANGOS:
+                self.assertNotIn("/run/dispram", json.dumps(obj), n)
+        # mentatd y check-checkpoints (los otros contenedores del pod) no lo ven: solo vllm y check-host
+        for dep in rangos(self.objs).values():
+            spec = pod(dep)
+            for c in spec["containers"] + spec["initContainers"]:
+                if c["name"] not in ("vllm", "check-host"):
+                    self.assertFalse([m for m in c.get("volumeMounts", []) if m["name"].startswith("dispram-")], c["name"])
+
+    def test_s2_ningun_otro_yaml_del_repo_menciona_run_dispram(self):
+        # tools/test_glm53_tp3_contract.py (main) lo comprueba en todo el repo; esta linea no lo trae.
+        permitidos = {OVERLAY_K64 / "patch-dispram.yaml"}
+        for path in ROOT.glob("**/*.yaml"):
+            if ".git" in path.parts or path in permitidos:
+                continue
+            self.assertNotIn("/run/dispram", path.read_text(encoding="utf-8", errors="replace"), path)
+
+
+class K64NoCambianTest(unittest.TestCase):
+    """Los renders del k4 y de la ventana son los de la linea (66a7553): este overlay solo anade un directorio."""
+
+    def comparar(self, path):
+        antes = render_en(LINEA_COMMIT, path)
+        if antes is None:
+            self.skipTest(f"{LINEA_COMMIT} no esta en este clon (CI hace fetch-depth 0)")
+        ahora = [d for d in yaml.safe_load_all(subprocess.run(["kubectl", "kustomize", str(path)], check=True, capture_output=True, text=True).stdout) if d]
+        self.assertEqual(ahora, antes)
+
+    def test_el_render_del_k4_de_la_ventana_no_cambia(self):
+        self.comparar(OVERLAY)
+
+    def test_el_render_de_la_ventana_no_cambia(self):
+        self.comparar(ventana.VENTANA)
+
+
 if __name__ == "__main__":
     unittest.main()
