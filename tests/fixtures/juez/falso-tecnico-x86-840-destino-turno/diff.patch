+class BloqueaStopHook(Base):
+    """SC-2212 (el NO PASA de qa de la épica SC-2209): el hook Stop bloquea un cierre sin `ESTADO:` y el rol escribe su
+    línea unos segundos después. El transcript acaba en el `stop_hook_summary` de ESE bloqueo y `turno_cerrado` lo ve
+    cerrado: medido (sid 91c03b43, pm de SC-2171, 09-10), el bus repartía «sin ESTADO» y paraba la unidad ~3 s después
+    del bloqueo, antes de la continuación. Mientras la marca del hook señala el último turno, el turno no está cerrado;
+    llega la continuación y se reparte por esa línea; sin ella pasado el tope (`STOP_BLOQUEO_S`), cierra sin ESTADO como hoy.
+    Y un cierre con `ESPERA:` vigilable (que el hook deja pasar) no es «sin ESTADO»: `bus-medida` lo cuenta en su cubo."""
+
+    def test_bloqueo_del_hook_no_da_el_turno_por_cerrado_ni_para_la_unidad(self):
+        sid = self.sesion("SC-20", "pm", perfil="pm")
+        self.jet.cerrar(sid, "a-1", "criterios verificados, sin línea de cierre")
+        cap.marcar_stop_bloqueo(self.jet, sid)                      # lo que el hook hace al bloquear
+        self.assertEqual(bus.turnos_cerrados(), [], "en la ventana del bloqueo: nada que repartir")
+        self.assertEqual(self.jet.paradas, [], "y la unidad no se para: el rol está escribiendo su línea")
+        self.assertEqual(self.enviados, [])
