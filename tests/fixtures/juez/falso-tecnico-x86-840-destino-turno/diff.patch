+# SC-2212 (el NO PASA de qa de la épica SC-2209): el hook `Stop` (`company_estado_hook.py`) bloquea un cierre sin
+# `ESTADO:` y el rol escribe su línea unos segundos después. En esa ventana el transcript acaba en el
+# `stop_hook_summary` de ESE bloqueo y `jet.turno_cerrado` lo ve cerrado: medido (sid 91c03b43, pm de SC-2171, 09-10),
+# el bus repartía «sin ESTADO» y paraba la unidad ~3 s después del bloqueo, segando la continuación. Al bloquear, el
+# hook deja una marca por sesión (`bots_dir()/stop-bloqueo/<sid>`, contenido: el `id_turno` que bloqueó): mientras la
+# marca señale el turno que hoy es el último y no hayan pasado STOP_BLOQUEO_S, el turno NO está cerrado. Pasado el tope
+# sin continuación, se da por cerrado sin ESTADO, como antes del arreglo. La gramática de `ESTADO:` no se copia: la
+# marca la escribe solo el hook, en el único momento en que sabe que bloqueó.
+STOP_BLOQUEO_S = float(os.getenv("STOP_BLOQUEO_S", "120"))
+
+
+def _ruta_stop_bloqueo(sid: str) -> str | None:
+    """La marca es un fichero por sid bajo `bots_dir()`; un sid que no es una palabra (no se fía del evento) no tiene."""
+    if not re.fullmatch(r"[\w-]{1,64}", sid or ""):
+        return None
+    return os.path.join(bots_dir(), "stop-bloqueo", sid)
+
+
+def marcar_stop_bloqueo(jet, sid: str) -> None:
+    """Lo que el hook `Stop` hace al BLOQUEAR un turno (SC-2212): deja la marca que lee `turno_cerrado_de`. Best
+    effort: si no se puede escribir, el bus cierra el turno como antes del arreglo; nunca rompe el bloqueo."""
+    ruta = _ruta_stop_bloqueo(sid)
+    if not ruta:
+        return
+    os.makedirs(os.path.dirname(ruta), exist_ok=True)
+    for viejo in os.scandir(os.path.dirname(ruta)):        # una marca por sesión: las caducadas no se acumulan
+        if viejo.is_file() and time.time() - viejo.stat().st_mtime > STOP_BLOQUEO_S:
+            try:
+                os.remove(viejo.path)
+            except OSError:
+                pass
+    with open(ruta, "w") as f:
+        f.write(jet.id_turno(sid) or "")
+
+
+def bloqueo_stop_pendiente(jet, sid: str) -> bool:
+    """¿El hook `Stop` bloqueó el cierre del turno que hoy es el último y sigue sin continuación? (SC-2212)"""
+    ruta = _ruta_stop_bloqueo(sid)
+    if not ruta:
+        return False
+    try:
+        with open(ruta) as f:
+            turno = f.read().strip()
+        ts = os.path.getmtime(ruta)
+    except OSError:
+        return False
+    return bool(turno) and time.time() - ts < STOP_BLOQUEO_S and jet.id_turno(sid) == turno
+
 
