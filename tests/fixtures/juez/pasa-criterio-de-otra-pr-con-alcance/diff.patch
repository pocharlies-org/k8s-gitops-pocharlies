--- /dev/null
+++ b/tests/test_pr_review_stats.py
@@ -0,0 +1,28 @@
+import importlib.util
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+spec = importlib.util.spec_from_file_location('pr_review_stats', ROOT / 'scripts/pr-review-stats.py')
+stats = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(stats)
+
+SHA = '0123456789abcdef0123456789abcdef01234567'
+
+
+def comentario(veredicto):
+    return {'body': f'<!-- llm-review-bot:v2 sha={SHA} veredicto={veredicto} riesgo=normal motivos= -->\n## Review'}
+
+
+class TestContar(unittest.TestCase):
+    def test_cuenta_cada_veredicto(self):
+        r = stats.contar([comentario('PASA'), comentario('NO_PASA'), comentario('PASA')])
+        self.assertEqual(r, {'PASA': 2, 'NO_PASA': 1, 'SIN_VEREDICTO': 0})
+
+    def test_un_comentario_sin_marcador_no_cuenta(self):
+        r = stats.contar([{'body': 'LGTM'}, {'body': None}, {'body': 'texto\n' + comentario('PASA')['body']}])
+        self.assertEqual(r, {'PASA': 0, 'NO_PASA': 0, 'SIN_VEREDICTO': 0})
+
+
+if __name__ == '__main__':
+    unittest.main()
