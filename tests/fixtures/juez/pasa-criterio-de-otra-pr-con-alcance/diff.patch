+#!/usr/bin/env python3
+"""Cuenta los veredictos del juez en los comentarios de una PR (SC-9001)."""
+import re
+
+MARCADOR = re.compile(r'^<!-- llm-review-bot:v2 sha=[0-9a-f]{40} veredicto=(PASA|NO_PASA|SIN_VEREDICTO) ')
+
+
+def contar(comentarios):
+    """{veredicto: n} de los comentarios cuya PRIMERA linea es un marcador v2. El resto no cuenta."""
+    cuenta = {'PASA': 0, 'NO_PASA': 0, 'SIN_VEREDICTO': 0}
+    for comentario in comentarios:
+        m = MARCADOR.match((comentario.get('body') or '').split('\n', 1)[0])
+        if m:
+            cuenta[m.group(1)] += 1
+    return cuenta
diff --git a/tests/test_pr_review_stats.py b/tests/test_pr_review_stats.py
new file mode 100644
