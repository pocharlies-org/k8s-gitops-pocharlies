index 0000000..44a4d86
--- /dev/null
+++ b/Packages/DGXKit/Sources/DGXKit/Inferencia/Alibaba.swift
@@ -0,0 +1,141 @@
+import Foundation
+
+// ─── Alibaba · Token Plan y modelos (DGX-783 · H3-b) ─────────────────────────────────────────
+//
+// Port de lo que `AlibabaQuotaSection.jsx`, `AlibabaCatalogSection.jsx` y `utils.js` (dgx-infra,
+// `static/inferencia/src/sections/`) calculan en el cliente sobre `GET /api/alibaba/accounts`,
+// `/api/alibaba/quota?account=N`, `/api/alibaba/uso-clase` y `/api/alibaba/catalog`. La LISTA de cuentas
+// manda: la web fija `account=1,2` (`ALIBABA_CUENTAS`) y la app no. El % de la ventana lo publica la
+// consola de Alibaba (nunca se calcula aquí); de aquí salen la marca del ritmo, el reparto por
+// consumidor y la celda del descuento nocturno. Solo lectura: «Refresh» y los interruptores de fallback
+// de la web no existen (tirar para releer los sustituye; R4 de security).
+
+public enum Alibaba {
+    public struct Cuenta: Equatable, Identifiable, Sendable {
+        /// El número que usa `/quota?account=` («1», «2»…).
+        public let id: String
+        public let label: String
+        public let usedPct: Double?
+        public let remainingPct: Double?
+        public let resetAt: String?
+        public let period: String?
+        public let planSpec: String?
+        public let remainingDays: Int?
+        public let readAt: String?
+        /// ¿Leída de la consola ahora, o guardada de una lectura anterior?
+        public let live: Bool
+        public let requests24h: Int?
+        public let tokens24h: Double?
+        public let share24h: Double?
+    }
+
+    /// Una fila por cuenta de la lista del servidor, en su orden. Con tres cuentas, tres filas.
+    public static func cuentas(de accounts: J) -> [Cuenta] {
+        accounts.accounts.array.compactMap { a in
+            guard let id = a.account.string, !id.isEmpty else { return nil }
+            return Cuenta(id: id, label: a.label.string ?? id, usedPct: a.used_pct.double, remainingPct: a.remaining_pct.double,
+                          resetAt: a.reset_at.string, period: a.period.string, planSpec: a.plan_spec.string,
+                          remainingDays: a.remaining_days.int, readAt: a.read_at.string, live: a.live.bool == true,
+                          requests24h: a.requests_24h.int, tokens24h: a.tokens_24h.double, share24h: a.share_24h_pct.double)
+        }
+    }
+
+    // ─── el ritmo de la ventana del plan ─────────────────────────────────────────────────────
+
+    /// Ritmo de la cuota de un plan con ventana fija (`quotaPace` de `utils.js`): para que dure hasta el reinicio, el
+    /// % usado no debería pasar del % de ventana transcurrido; esa es la marca que pinta la barra.
+    public struct Ritmo: Equatable, Sendable {
+        public let pacePct: Double
+        /// Usado − ritmo, en puntos (negativo = va por debajo, bien).
+        public let deltaPts: Double
+        /// `ok` (≤ ritmo), `warn` (hasta 10 pts por encima) u `over`.
+        public let estado: String
+        /// A este paso, cuándo se agota; nil si no se agota antes del reinicio.
+        public let agotaEn: Date?
+    }
+
+    /// `ventana` = `quota.window` (`used_pct`, `window_start`, `window_end` o `reset_at`). Sin lectura no hay ritmo: nil.
+    public static func ritmo(ventana w: J, ahora: Date = Date()) -> Ritmo? {
+        guard let used = w.used_pct.double else { return nil }
+        let start = w.window_start.string.flatMap(parseISODate), end = w.window_end.string.flatMap(parseISODate) ?? w.reset_at.string.flatMap(parseISODate)
+        guard let start, let end, end > start else { return nil }
+        let s = start.timeIntervalSince1970, e = end.timeIntervalSince1970, now = ahora.timeIntervalSince1970
+        let pace = min(100, max(0, (now - s) / (e - s) * 100))
+        let delta = used - pace
+        var agota: Date?
+        if used > 0 && now > s {
+            let t = s + (now - s) * (100 / used)
+            if t < e { agota = Date(timeIntervalSince1970: t) }
+        }
+        return Ritmo(pacePct: pace, deltaPts: delta, estado: delta <= 0 ? "ok" : delta <= 10 ? "warn" : "over", agotaEn: agota)
+    }
+
+    // ─── el reparto por consumidor ───────────────────────────────────────────────────────────
+
+    /// Las clases en que parte la barra de cada cuenta, en el orden de la web (`USO_CLASES`).
+    public static let clases: [(id: String, label: String)] = [
+        ("opencode", "opencode / Claude CLI"), ("compania", "compañía"), ("hermes", "Hermes"), ("otros", "otros"),
+    ]
+
+    public struct Tramo: Equatable, Identifiable, Sendable {
+        public let id: String
+        public let label: String
+        /// El % de la CUENTA que le toca (Σ = % usado).
+        public let pct: Double
+        /// Su parte de los tokens de la ventana.
+        public let share: Double
+        /// Tokens de la ventana.
+        public let tokens: Double?
+    }
+
+    /// El uso de la cuenta `id` en `/api/alibaba/uso-clase`; J(nil) si no está.
+    public static func usoDe(cuenta id: String, usoClase: J) -> J {
+        usoClase.cuentas.array.first { $0.account.string == id } ?? J(nil)
+    }
+
+    /// `claseSegments`: el % usado de la consola partido por la parte de tokens de cada clase. Sin reparto medible, [].
+    public static func tramos(usedPct: Double?, uso: J) -> [Tramo] {
+        guard let usedPct, uso.clases.exists else { return [] }
+        let used = max(0, min(usedPct, 100))
+        var out: [Tramo] = []
+        for c in clases {
+            guard let share = uso.clases[c.id].share_ventana.double else { return [] }
+            out.append(Tramo(id: c.id, label: c.label, pct: used * share, share: share, tokens: uso.clases[c.id].ventana.double))
+        }
+        return out
+    }
+
+    /// 9509138490 → «9,51 G»: tokens con la abreviatura de la app (`Fmt.compact`); nil es «—», nunca un 0.
+    public static func fmtTok(_ n: Double?) -> String { Fmt.compact(n) }
+
+    // ─── el catálogo ─────────────────────────────────────────────────────────────────────────
+
+    public struct Modelo: Equatable, Identifiable, Sendable {
+        public let id: String
+        public let nombre: String
+        public let proveedor: String
+        public let capacidades: [String]
+        /// % de descuento nocturno de ESTE modelo; nil = sin descuento (raya, nunca un 0 % que parezca «casi gratis»).
+        public let nocturnoPct: Double?
+        public let nuevo: Bool
+    }
+
+    public static func modelos(de catalog: J) -> [Modelo] {
+        catalog.models.array.compactMap { m in
+            guard let id = m.model.string else { return nil }
+            let pct = m.night_pct.double.flatMap { $0 == 0 ? nil : $0 }
+            return Modelo(id: id, nombre: m.name.string ?? id, proveedor: m.provider.string ?? "",
+                          capacidades: m.cap_labels.strings, nocturnoPct: pct, nuevo: m.is_new.bool == true)
+        }
+    }
+
+    /// «40 % · España 16:00–02:00 · Singapur 22:00–08:00», o «—» sin descuento. Las dos horas van juntas a propósito.
+    public static func celdaNocturna(_ m: Modelo, ventana w: J) -> String {
+        guard let pct = m.nocturnoPct else { return "—" }
+        var partes: [String] = []
+        if let spain = w.spain.string { partes.append("\(w.spain_word.string ?? "España") \(spain)") }
+        if let utc8 = w.utc8.string { partes.append("\(w.utc8_word.string ?? "Singapur") \(utc8)") }
+        let p = pct == pct.rounded() ? String(Int(pct)) : String(pct)
+        return partes.isEmpty ? "\(p) %" : "\(p) % · " + partes.joined(separator: " · ")
+    }
+}
diff --git a/Packages/DGXKit/Tests/DGXKitTests/AlibabaTests.swift b/Packages/DGXKit/Tests/DGXKitTests/AlibabaTests.swift
new file mode 100644
index 0000000..c957b5b
--- /dev/null
+++ b/Packages/DGXKit/Tests/DGXKitTests/AlibabaTests.swift
@@ -0,0 +1,88 @@
+import XCTest
+@testable import DGXKit
+
+// DGX-783 · H3-b, C8. La lista de cuentas la da `/api/alibaba/accounts` (la web fija `account=1,2` y la app no); la cuota
+// de cada una sale de `/api/alibaba/quota?account=N`, el reparto de `/api/alibaba/uso-clase` y los modelos de `/api/alibaba/catalog`.
+final class AlibabaTests: XCTestCase {
+    private var accounts: J { RoutingFixtures.vivo("alibaba/accounts") }
+
+    func testCuentasSalenDeLaLista() throws {
+        let reales = Alibaba.cuentas(de: accounts)
+        XCTAssertEqual(reales.map(\.id), accounts.accounts.array.compactMap { $0.account.string })
+        XCTAssertEqual(reales.map(\.label), accounts.accounts.array.compactMap { $0.label.string })
+        XCTAssertFalse(reales.isEmpty)
+
+        // Con una tercera cuenta en la lista salen tres filas: nada fija «1» y «2».
+        var lista = accounts.raw as! [String: Any]
+        var filas = lista["accounts"] as! [[String: Any]]
+        var tercera = filas[filas.count - 1]
+        tercera["account"] = "3"; tercera["label"] = "tercera"
+        filas.append(tercera)
+        lista["accounts"] = filas
+        let tres = Alibaba.cuentas(de: J(lista))
+        XCTAssertEqual(tres.count, reales.count + 1)
+        XCTAssertEqual(tres.last?.id, "3")
+        XCTAssertEqual(tres.last?.label, "tercera")
+        XCTAssertEqual(tres.first?.usedPct, reales.first?.usedPct)
+
+        // Una cuenta sin número no es una fila; sin lista, ninguna.
+        XCTAssertEqual(Alibaba.cuentas(de: J(["accounts": [["label": "sin id"]]])).count, 0)
+        XCTAssertEqual(Alibaba.cuentas(de: J(nil)).count, 0)
+    }
+
+    func testRitmoDelPlan() throws {
+        let q = RoutingFixtures.vivo("alibaba/quota.account-1")
+        let w = q.window
+        let inicio = try XCTUnwrap(parseISODate(w.window_start.string!)), fin = try XCTUnwrap(parseISODate(w.window_end.string!))
+        // A mitad de la ventana el ritmo es el 50 %; con el 96,6 % usado va muy por encima y se acaba antes del reinicio.
+        let mitad = Date(timeIntervalSince1970: (inicio.timeIntervalSince1970 + fin.timeIntervalSince1970) / 2)
+        let r = try XCTUnwrap(Alibaba.ritmo(ventana: w, ahora: mitad))
+        XCTAssertEqual(r.pacePct, 50, accuracy: 1e-9)
+        XCTAssertEqual(r.deltaPts, (w.used_pct.double ?? 0) - 50, accuracy: 1e-9)
+        XCTAssertEqual(r.estado, "over")
+        // A este paso (96,6 % usado a mitad de ventana) se acaba antes del reinicio, pero todavía no.
+        let agota = try XCTUnwrap(r.agotaEn)
+        XCTAssertGreaterThan(agota, mitad)
+        XCTAssertLessThan(agota, fin)
+        // Antes de empezar y después de acabar la marca no sale de 0 y 100.
+        XCTAssertEqual(Alibaba.ritmo(ventana: w, ahora: inicio.addingTimeInterval(-3600))?.pacePct, 0)
+        XCTAssertEqual(Alibaba.ritmo(ventana: w, ahora: fin.addingTimeInterval(3600))?.pacePct, 100)
+        // Por debajo de su ritmo: bien, y no se agota.
+        let bajo = J(["used_pct": 10.0, "window_start": w.window_start.string!, "window_end": w.window_end.string!])
+        let ok = try XCTUnwrap(Alibaba.ritmo(ventana: bajo, ahora: mitad))
+        XCTAssertEqual(ok.estado, "ok")
+        XCTAssertNil(ok.agotaEn)
+        // Sin lectura (la consola no la dio) no hay ritmo que enseñar.
+        XCTAssertNil(Alibaba.ritmo(ventana: J(["used_pct": NSNull()]), ahora: mitad))
+        XCTAssertNil(Alibaba.ritmo(ventana: J(nil), ahora: mitad))
+    }
+
+    func testRepartoPorConsumidor() throws {
+        let uso = RoutingFixtures.vivo("alibaba/uso-clase")
+        for cuenta in uso.cuentas.array {
+            let u = Alibaba.usoDe(cuenta: cuenta.account.string!, usoClase: uso)
+            let usado = cuenta.used_pct.double!
+            let tramos = Alibaba.tramos(usedPct: usado, uso: u)
+            XCTAssertEqual(tramos.map(\.id), ["opencode", "compania", "hermes", "otros"])
+            // Los tramos suman el % usado de la cuenta.
+            XCTAssertEqual(tramos.reduce(0) { $0 + $1.pct }, usado * tramos.reduce(0) { $0 + $1.share }, accuracy: 1e-9)
+        }
+        XCTAssertTrue(Alibaba.tramos(usedPct: nil, uso: uso.cuentas[0]).isEmpty, "sin % de la consola no hay reparto")
+        XCTAssertTrue(Alibaba.tramos(usedPct: 50, uso: J(nil)).isEmpty)
+        XCTAssertTrue(Alibaba.usoDe(cuenta: "9", usoClase: uso).raw == nil)
+    }
+
+    func testCatalogoYDescuentoNocturno() throws {
+        let cat = RoutingFixtures.vivo("alibaba/catalog")
+        let modelos = Alibaba.modelos(de: cat)
+        XCTAssertEqual(modelos.count, cat["count"].int)
+        XCTAssertEqual(modelos.map(\.id), cat.models.array.compactMap { $0.model.string })
+        let conDescuento = try XCTUnwrap(modelos.first { $0.nocturnoPct != nil })
+        let celda = Alibaba.celdaNocturna(conDescuento, ventana: cat.night_window)
+        XCTAssertTrue(celda.hasPrefix("\(Int(conDescuento.nocturnoPct!)) % · España "), celda)
+        XCTAssertTrue(celda.contains("Singapur "), celda)
+        // Sin badge no hay descuento: raya, nunca un «0 %».
+        let sin = try XCTUnwrap(modelos.first { $0.nocturnoPct == nil })
+        XCTAssertEqual(Alibaba.celdaNocturna(sin, ventana: cat.night_window), "—")
+    }
+}
