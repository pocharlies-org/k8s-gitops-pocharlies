+#!/usr/bin/python3 -I
+"""reminders-bridge — la orden forzada de la clave de las secretarias de Hermes en el x86 (INFRA-804).
+
+El authorized_keys de dibanez en el x86 la fuerza para la clave `hermes-secretaria-x86` (privada solo en el Secret
+`hermes/hermes-secretaria-ssh`):
+
+    command="/home/dibanez/.local/libexec/x86-host-runtime/reminders-bridge",restrict,from="…" ssh-ed25519 … INFRA-804
+
+Con esa clave no hay shell, ni pty, ni reenvío de puertos: sshd ignora la orden del cliente, la deja en
+SSH_ORIGINAL_COMMAND y ejecuta esto, que solo admite
+
+    reminders            el AppleScript por stdin
+    reminders <base64>   el AppleScript en base64
+
+y la reenvía tal cual a `ssh mac-reminders` (clave dedicada `hermes-secretaria-mac`, que en el Mac solo puede
+ejecutar `reminders-runner`, el que comprueba que el guion habla solo con Reminders). Todo lo demás —`ssh mac …`,
+`uname`, `curl localhost:9222`, una shell interactiva (orden vacía)— se rechaza con un mensaje y salida 2.
+Cada rechazo deja una línea en el journal (`journalctl --user -t reminders-bridge` o `-t` en el del
+sistema), sin el contenido.
+"""
+import os
+import re
+import sys
+import syslog
+
+B64 = re.compile(r"^[A-Za-z0-9+/]+={0,2}$")
+MAX_ARG = 96 * 1024
+DESTINO = "mac-reminders"
+
+
+def orden_admitida(orden):
+    """La lista de argumentos que se reenvía al Mac, o ValueError con el motivo."""
+    partes = (orden or "").split()
+    if not partes:
+        raise ValueError("sin orden: esta clave no abre una shell")
+    if partes[0] != "reminders" or len(partes) > 2:
+        raise ValueError("orden no admitida: solo «reminders» (guion por stdin) o «reminders <base64>»")
+    if len(partes) == 2 and (len(partes[1]) > MAX_ARG or not B64.match(partes[1])):
+        raise ValueError("el argumento no es base64")
+    return partes
+
+
+def main():
+    orden = os.environ.get("SSH_ORIGINAL_COMMAND", "")
+    try:
+        partes = orden_admitida(orden)
+    except ValueError as e:
+        syslog.openlog("reminders-bridge")
+        syslog.syslog(syslog.LOG_WARNING, "rechazado: %s (orden de %d caracteres)" % (e, len(orden)))
+        print("reminders-bridge: rechazado: %s" % e, file=sys.stderr)
+        return 2
+    ssh = ["/usr/bin/ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", "-T", DESTINO] + partes
+    os.execv(ssh[0], ssh)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
