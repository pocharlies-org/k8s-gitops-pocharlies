+#!/usr/bin/python3 -I
+"""reminders-runner — la orden forzada de la clave de las secretarias en el Mac de Dani (INFRA-804).
+
+Corre en el Mac, nunca en el x86: lo instala IT copiándolo del x86 (ARCHITECTURE.md, «Reminders de las secretarias»)
+a ~/.local/bin/reminders-runner, y el authorized_keys del Mac lo fuerza para la clave `hermes-secretaria-mac`:
+
+    command="/Users/usuario/.local/bin/reminders-runner",restrict,no-port-forwarding,no-pty,from="<x86>" ssh-ed25519 … INFRA-804
+
+Con `command=` sshd ignora la orden que pide el cliente y la deja en SSH_ORIGINAL_COMMAND. Este programa solo
+entiende una:
+
+    reminders            el AppleScript llega por stdin
+    reminders <base64>   el AppleScript va en base64 en la propia orden
+
+y solo ejecuta (`osascript -`, lenguaje AppleScript) un guion que habla con la app Reminders y con nada más.
+Cualquier otra cosa (shell, `uname`, `curl localhost:9222`, Chrome, System Events, `do shell script`…) se rechaza
+con un mensaje en stderr y salida 2, sin ejecutar nada.
+
+La comprobación mira el CÓDIGO del guion, no sus textos: los literales entre comillas son datos (el nombre y el
+cuerpo de un recordatorio pueden decir «chrome» o «curl»). Fuera de ellos:
+  - solo ASCII (fuera «», ¬, comillas tipográficas y homoglifos), sin comentarios ni identificadores |entre barras|;
+  - cada `application`/`app` va seguido del literal "Reminders" (fuera `application id …`, `current application`,
+    `application x`), y tiene que haber al menos uno;
+  - ninguna palabra de las adiciones o del sistema (PROHIBIDAS): do shell script, run/load/store script, open
+    location, read/write de ficheros, the clipboard, path to, POSIX file, display/choose, use framework, machine…
+Las comillas tipográficas se rechazan en todo el guion, también dentro de los textos.
+"""
+import base64
+import datetime
+import hashlib
+import os
+import re
+import subprocess
+import sys
+
+MAX_BYTES = 64 * 1024
+TIMEOUT_S = 1800  # las lecturas grandes de Reminders tardan minutos (skill apple-reminders-ssh)
+OSASCRIPT = "/usr/bin/osascript"
+LOG = os.path.expanduser("~/Library/Logs/reminders-runner.log")
+APP = "Reminders"
+
+PROHIBIDAS = frozenset("""
+do script run shell osascript open read write eof access mount volume system clipboard use framework
+javascript path posix alias file folder disk disks info display choose url location machine me my
+""".split())
+
+B64 = re.compile(r"^[A-Za-z0-9+/]+={0,2}$")
+IDENT = re.compile(r"[a-z_][a-z0-9_]*")
+APP_REF = re.compile(r"\b(?:application|app)\b")
+TRAS_APP = re.compile(r'\s*"(\d+)"')
+TIPOGRAFICAS = "“”„‟″‶＂"
+
+
+def _lexico(guion):
+    """(esqueleto, literales): el guion con cada literal "…" cambiado por "<n>", o ValueError con el motivo."""
+    if any(c in guion for c in TIPOGRAFICAS):
+        raise ValueError("comillas tipográficas: usa solo comillas rectas")
+    esqueleto, literales, i, n = [], [], 0, len(guion)
+    while i < n:
+        c = guion[i]
+        if c == '"':
+            j, buf = i + 1, []
+            while j < n and guion[j] != '"':
+                if guion[j] == "\\":
+                    buf.append(guion[j:j + 2])
+                    j += 2
+                    continue
+                buf.append(guion[j])
+                j += 1
+            if j >= n:
+                raise ValueError("texto sin cerrar")
+            esqueleto.append('"%d"' % len(literales))
+            literales.append("".join(buf))
+            i = j + 1
+            continue
+        if c == "-" and guion.startswith("--", i) or c == "#" or guion.startswith("(*", i):
+            raise ValueError("comentarios no admitidos")
+        if c == "|":
+            raise ValueError("identificadores |entre barras| no admitidos")
+        if ord(c) > 126 or (ord(c) < 32 and c not in "\t\r\n"):
+            raise ValueError("carácter no admitido fuera de un texto: U+%04X" % ord(c))
+        esqueleto.append(c)
+        i += 1
+    return "".join(esqueleto).lower(), literales
+
+
+def validar(guion):
+    """None si el guion solo habla con Reminders; si no, el motivo del rechazo."""
+    if not guion.strip():
+        return "guion vacío"
+    try:
+        esqueleto, literales = _lexico(guion)
+    except ValueError as e:
+        return str(e)
+    refs = 0
+    for m in APP_REF.finditer(esqueleto):
+        t = TRAS_APP.match(esqueleto, m.end())
+        if not t or literales[int(t.group(1))] != APP:
+            return 'solo se admite application "%s"' % APP
+        refs += 1
+    if not refs:
+        return 'el guion no habla con application "%s"' % APP
+    malas = sorted(set(IDENT.findall(esqueleto)) & PROHIBIDAS)
+    if malas:
+        return "palabras no admitidas: %s" % ", ".join(malas)
+    return None
+
+
+def leer_orden(orden, stdin):
+    """El guion (str) que pide la orden de ssh, o ValueError con el motivo."""
+    partes = (orden or "").split()
+    if not partes or partes[0] != "reminders" or len(partes) > 2:
+        raise ValueError("orden no admitida: solo «reminders» (guion por stdin) o «reminders <base64>»")
+    if len(partes) == 2:
+        if len(partes[1]) > MAX_BYTES * 4 // 3 + 4 or not B64.match(partes[1]):
+            raise ValueError("el argumento no es base64")
+        datos = base64.b64decode(partes[1], validate=True)
+    else:
+        datos = stdin.read(MAX_BYTES + 1)
+    if len(datos) > MAX_BYTES:
+        raise ValueError("guion de más de %d bytes" % MAX_BYTES)
+    try:
+        return datos.decode("utf-8")
+    except UnicodeDecodeError:
+        raise ValueError("el guion no es UTF-8")
+
+
+def _log(veredicto, datos=b""):
+    try:
+        with open(LOG, "a", encoding="utf-8") as fh:
+            fh.write("%s %s sha256=%s bytes=%d\n" % (
+                datetime.datetime.now().isoformat(timespec="seconds"), veredicto,
+                hashlib.sha256(datos).hexdigest()[:16], len(datos)))
+    except OSError:
+        pass
+
+
+def main():
+    orden = os.environ.get("SSH_ORIGINAL_COMMAND", "")
+    try:
+        guion = leer_orden(orden, sys.stdin.buffer)
+        motivo = validar(guion)
+        if motivo:
+            raise ValueError(motivo)
+    except ValueError as e:
+        _log("rechazado: %s" % e, orden.encode("utf-8", "replace"))
+        print("reminders-runner: rechazado: %s" % e, file=sys.stderr)
+        return 2
+    datos = guion.encode("utf-8")
+    try:
+        r = subprocess.run([OSASCRIPT, "-"], input=datos, timeout=TIMEOUT_S,
+                           env={"PATH": "/usr/bin:/bin", "HOME": os.path.expanduser("~"), "LANG": "en_US.UTF-8"})
+    except subprocess.TimeoutExpired:
+        _log("timeout", datos)
+        print("reminders-runner: osascript superó %d s" % TIMEOUT_S, file=sys.stderr)
+        return 124
+    _log("ok rc=%d" % r.returncode, datos)
+    return r.returncode
+
+
+if __name__ == "__main__":
+    sys.exit(main())
