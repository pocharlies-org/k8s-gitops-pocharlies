+    def test_vocab_mask_neg_inf_above_248320(self):
+        marker = "QWEN_TP3_VOCAB_MASK"
+        source = image_source(marker)
+        done, target, tmp = run_block(marker, source, 3, TP3_CONFIG)
+        with tmp:
+            self.assertEqual(done.returncode, 0, done.stderr)
+            self.assertEqual(done.stdout.strip(), f"{marker} aplicado (-inf en ids >= 248320 de 248448)")
+            patched = target.read_text()
+        # Las tres rutas de LogitsProcessor (muestreo y prompt_logprobs, top-1 y top-k del borrador
+        # MTP) pasan por _apply_head, que es donde va el -inf.
+        cls = next(n for n in ast.parse(patched).body if isinstance(n, ast.ClassDef) and n.name == "LogitsProcessor")
+        for fn in (n for n in cls.body if isinstance(n, ast.FunctionDef)):
+            if fn.name in ("_get_logits", "get_top_tokens", "get_top_k_tokens"):
+                self.assertIn("self._apply_head(lm_head, hidden_states, embedding_bias)", ast.unparse(fn), fn.name)
+        for head_dtype in (None, "float32"):
+            with self.subTest(head_dtype=head_dtype):
+                logits = gathered_logits(patched, head_dtype)
+                for row in logits:
+                    self.assertEqual(len(row), 248448)
+                    self.assertTrue(all(v == -1.0 for v in row[:248320]))
+                    self.assertTrue(all(v == NEG_INF for v in row[248320:]))
+                    self.assertLess(max(range(len(row)), key=row.__getitem__), 248320)
+        # sin el parche, el relleno da logit 0 y gana a todos los ids reales
+        row = gathered_logits(source)[0]
+        self.assertGreaterEqual(max(range(len(row)), key=row.__getitem__), 248320)
+
