+#!/usr/bin/env python3
+"""Parche QWEN_FI_EP_UNEVEN de `launch.sh` (DGX-672, portado en DGX-780): FlashInfer CUTLASS con EP desigual.
+
+POR QUE EXISTE
+--------------
+Con EP=3 vLLM reparte 512 expertos como 171/171/170 empezando en 0/171/342
+(`expert_map_manager.determine_expert_map`, reparto `linear`). `FlashInferExperts.apply`
+solo le pasa a FlashInfer `ep_size`/`ep_rank`, y el binding supone reparto igual
+(`start = ep_rank * num_experts_on_rank`): el rango 2 empezaria en 340, no en 342.
+El parche (un bloque `python3 - <<'PYEOF'` de `launch.sh`) reescribe `topk_ids` antes de
+la llamada para que el kernel vea la numeracion que supone. Aqui se prueba SIN GPU ni
+torch ni vLLM:
+
+  * el bloque que se ejecuta es el REAL, sacado del ConfigMap con `yaml.safe_load_all`
+    y corrido por `python3 -` contra una copia del fichero de la imagen;
+  * la `apply` parcheada se carga por `ast` con globals falsos y se ejecuta para los
+    tres rangos contra un `flashinfer_cutlass_fused_moe` falso que emula lo leido en
+    `cutlass_fused_moe_kernels.cuh` (reparto start/end y descarte fuera de rango).
+
+LIMITES (no se prometen otros)
+------------------------------
+* El fixture es una COPIA CONGELADA del fichero de la imagen vLLM 0.28.1rc1.dev628: este
+  test no ve nunca una imagen nueva. Que vLLM cambie el fichero lo para el arranque: con
+  tp % 3 == 0 (o E % ep != 0) y sin patron, el bloque sale con 1 (DGX-780, hallazgo 9).
+* Con TP=2 y E % ep == 0 el bloque no abre el fichero: se prueba que no cambia ni un byte.
+* La emulacion del kernel es una lectura, no el kernel. La contrasta la prueba con el
+  kernel real que se documenta en `50-entrega.md` del ticket, y el log del primer arranque.
+"""
+
+import ast
+import hashlib
+import json
+import os
+import random
+import re
+import subprocess
+import sys
+import tempfile
+import types
+import unittest
+from contextlib import redirect_stdout
+from io import StringIO
+from pathlib import Path
+
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+MANIFEST = ROOT / "k8s/qwen38-flash-next-nvfp4-vllm.yaml"
+FIXTURE = ROOT / "tools/fixtures/flashinfer_cutlass_moe.vllm-0.28.1rc1.dev628.py"
+FI_REL = "model_executor/layers/fused_moe/experts/flashinfer_cutlass_moe.py"
+ANCHOR = "        _ = flashinfer_cutlass_fused_moe(\n"
+MARKER = "QWEN_FI_EP_UNEVEN"
+AUTO = object()  # expert_map = el de vLLM para ese rango (None con ep_size == 1)
+
+
+def launch_block():
+    """El heredoc de `launch.sh` que lleva el marcador, tal cual lo ejecuta el pod."""
+    with open(MANIFEST, encoding="utf-8") as fh:
+        cm = next(
+            d
+            for d in yaml.safe_load_all(fh)
+            if d
+            and d.get("kind") == "ConfigMap"
+            and d["metadata"]["name"] == "qwen38-flash-next-vllm-launch"
+        )
+    blocks = [
+        b
+        for b in re.findall(
+            r"python3 - <<'PYEOF'\n(.*?)\nPYEOF", cm["data"]["launch.sh"], re.S
+        )
+        if MARKER in b
+    ]
+    assert len(blocks) == 1, f"se esperaba un bloque {MARKER}, hay {len(blocks)}"
+    return blocks[0] + "\n"
+
+
+def make_site(root, source):
+    """`<root>/vllm/...` con el fichero de la imagen; `import vllm` apunta aqui."""
+    pkg = Path(root) / "vllm"
+    target = pkg / FI_REL
+    target.parent.mkdir(parents=True)
+    (pkg / "__init__.py").write_text("")
+    target.write_text(source)
+    return target
+
+
+def run_block(site_root, block, tp=3, experts=512):
+    """El bloque como lo corre launch.sh: QWEN_TP_SIZE de ARGS y el config.json de MODEL_PATH."""
+    model = Path(site_root) / "model"
+    model.mkdir(exist_ok=True)
+    (model / "config.json").write_text(json.dumps({"text_config": {"num_experts": experts}}))
+    return subprocess.run(
+        [sys.executable, "-"],
+        input=block,
+        text=True,
+        capture_output=True,
+        env={**os.environ, "PYTHONPATH": str(site_root), "QWEN_TP_SIZE": str(tp), "MODEL_PATH": str(model)},
+        cwd=site_root,
+        check=False,
+    )
+
+
+class T(list):
+    """Tensor falso: lista (anidada) con la aritmetica entera que usa el bloque."""
+
+    def __getitem__(self, ids):
+        if isinstance(ids, list):
+            return T(self[i] for i in ids)
+        return list.__getitem__(self, ids)
+
+    def __add__(self, n):
+        return T(x + n for x in self)
+
+    def __mod__(self, n):
+        return T(x % n for x in self)
+
+    def to(self, _dtype):
+        return self
+
+
+TORCH = types.SimpleNamespace(float8_e4m3fn="fp8", int="int", long="long")
+ACTIVATION = types.SimpleNamespace(SILU="silu")
+
+
+def split(num_experts, ep_size, rank):
+    """Reparto `linear` de vLLM: los primeros `resto` rangos llevan uno mas."""
+    base, rest = divmod(num_experts, ep_size)
+    return base + (rank < rest), rank * base + min(rank, rest)
+
+
+def expert_map_of(num_experts, ep_size, rank):
+    n, start = split(num_experts, ep_size, rank)
+    return T(g - start if start <= g < start + n else -1 for g in range(num_experts))
+
+
+class Harness:
+    """La `apply` de FlashInferExperts de un fichero dado, con kernel y torch falsos."""
+
+    def __init__(self, source):
+        self.calls = []
+        self.log = StringIO()  # lo que imprime la apply parcheada
+        env = {
+            "torch": TORCH,
+            "MoEActivation": ACTIVATION,
+            "activation_to_flashinfer_type": lambda a: a,
+            "flashinfer_cutlass_fused_moe": self._kernel,
+        }
+        cls = next(
+            n
+            for n in ast.parse(source).body
+            if isinstance(n, ast.ClassDef) and n.name == "FlashInferExperts"
+        )
+        fn = next(
+            n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == "apply"
+        )
+        module = ast.parse("from __future__ import annotations")
+        module.body.append(fn)
+        exec(compile(module, "<FlashInferExperts.apply>", "exec"), env)
+        self.apply = env["apply"]
+
+    def _kernel(self, **kw):
+        """Lo leido en cutlass_fused_moe_kernels.cuh: start = ep_rank * n_local,
+        end = start + n_local, y los ids fuera de [start, end) no suman."""
+        self.calls.append(kw)
+        weights = kw["fc1_expert_weights"]
+        start = kw["ep_rank"] * len(weights)
+        rows = zip(kw["token_selected_experts"], kw["token_final_scales"], kw["input"])
+        for i, (ids, scales, x) in enumerate(rows):
+            for e, s in zip(ids, scales):
+                if start <= e < start + len(weights):
+                    # el experto de un slot es el que hay en `weights[slot]`
+                    kw["output"][i] += s * (weights[e - start] * 7 + 3) * x
+
+    @staticmethod
+    def experts(num_experts, ep_size, rank):
+        """El `self` de un FlashInferExperts bf16 sin cuantizar (la ruta `else`)."""
+        return types.SimpleNamespace(
+            num_experts=split(num_experts, ep_size, rank)[0],
+            ep_size=ep_size,
+            ep_rank=rank,
+            tp_size=1,
+            tp_rank=0,
+            quant_dtype=None,
+            weight_quant_dtype=None,
+            use_deepseek_fp8_block_scale=False,
+            gemm1_clamp_limit=None,
+            out_dtype="bf16",
+        )
+
+    def run(self, num_experts, ep_size, rank, batch, expert_map=AUTO, ids=None, me=None):
+        n, start = split(num_experts, ep_size, rank)
+        if expert_map is AUTO:
+            expert_map = expert_map_of(num_experts, ep_size, rank) if ep_size > 1 else None
+        rows, scales, xs = batch
+        out = [0] * len(xs)
+        with redirect_stdout(self.log):
+            self.apply(
+                me or self.experts(num_experts, ep_size, rank),
+                output=out,
+                hidden_states=xs,
+                w1=list(range(start, start + n)),
+                w2=None,
+                topk_weights=scales,
+                topk_ids=ids if ids is not None else T(T(r) for r in rows),
+                activation=ACTIVATION.SILU,
+                global_num_experts=num_experts,
+                expert_map=expert_map,
+                a1q_scale=None,
+                a2_scale=None,
+                workspace13=None,
+                workspace2=None,
+                expert_tokens_meta=None,
+                apply_router_weight_on_input=False,
+            )
+        return out
+
+
+def make_batch(num_experts, topk, forced):
+    """64 tokens de `random.Random(0)` mas un token por cada tupla de `forced`
+    (ids que ese token tiene que elegir; el resto, aleatorios y distintos)."""
+    rng = random.Random(0)
+    rows = [rng.sample(range(num_experts), topk) for _ in range(64)]
+    for must in forced:
+        rest = [e for e in range(num_experts) if e not in must]
+        rows.append(list(must) + rng.sample(rest, topk - len(must)))
+    scales = [[rng.randint(1, 5) for _ in r] for r in rows]
+    return rows, scales, [rng.randint(1, 9) for _ in rows]
+
+
+def reference(batch):
+    rows, scales, xs = batch
+    return [
+        sum(s * (e * 7 + 3) * x for e, s in zip(r, sc)) for r, sc, x in zip(rows, scales, xs)
+    ]
+
+
+# E=512/EP=3 (171/171/170) con 8 ids por token y los extremos del reparto; E=8/EP=3 (3/3/2)
+# con un token que elige el ultimo experto del rango 2 y otro sin nada local en dos rangos.
+CASES = (
+    (512, 8, [(340,), (341,), (510,), (511,)]),
+    (8, 2, [(7,), (0, 1), (3, 4)]),
+)
+
+
+class FiEpUnevenTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.fixture = FIXTURE.read_text()
+        cls.block = launch_block()
+        cls._tmp = tempfile.TemporaryDirectory()
+        cls.addClassCleanup(cls._tmp.cleanup)
+        target = make_site(cls._tmp.name, cls.fixture)
+        done = run_block(cls._tmp.name, cls.block)
+        assert done.returncode == 0 and f"{MARKER} aplicado" in done.stdout, done
+        cls.patched = target.read_text()
+        cls.raw = Harness(cls.fixture)
+        cls.fixed = Harness(cls.patched)
+
+    def test_ep3_uneven_sum_of_ranks_equals_single_rank_reference(self):
+        for num_experts, topk, forced in CASES:
+            with self.subTest(experts=num_experts):
+                batch = make_batch(num_experts, topk, forced)
+                single = self.fixed.run(num_experts, 1, 0, batch)
+                self.assertEqual(single, reference(batch))
+                ranks = [self.fixed.run(num_experts, 3, r, batch) for r in range(3)]
+                self.assertEqual([sum(col) for col in zip(*ranks)], single)
+                self.assertTrue(all(any(o) for o in ranks))
+
+    def test_unpatched_ep3_rank2_misroutes_experts(self):
+        # Documenta el bug contra el fixture congelado (no detecta cambios de vLLM).
+        def rank2(ids):
+            batch = ([ids], [[1] * len(ids)], [1])
+            return self.raw.run(512, 3, 2, batch)[0]
+
+        def value(g):
+            return g * 7 + 3
+
+        # el rango 2 de vLLM empieza en 342, el kernel cree que en 340: todo se corre 2
+        self.assertEqual(rank2([340]), value(342))
+        self.assertEqual(rank2([341]), value(343))
+        self.assertEqual(rank2([342]), value(344))
+        self.assertEqual(rank2([509]), value(511))
+        # 510 y 511 quedan fuera de [340, 510): ningun rango los suma
+        batch = make_batch(512, 8, [(510, 511)])
+        self.assertEqual(rank2([510, 511]), 0)
+        total = [sum(col) for col in zip(*(self.raw.run(512, 3, r, batch) for r in range(3)))]
+        self.assertNotEqual(total, reference(batch))
+
+    def test_even_ep2_patched_apply_is_identical(self):
+        # Texto: el parche solo inserta el bloque antes del ancla, nada mas cambia.
+        i = self.fixture.index(ANCHOR)
+        self.assertTrue(self.patched.startswith(self.fixture[:i]))
+        self.assertTrue(self.patched.endswith(self.fixture[i:]))
+        inserted = self.patched[i : len(self.patched) - len(self.fixture) + i]
+        self.assertIn(MARKER, inserted)
+        # Comportamiento: con reparto par el kernel recibe el mismo objeto y los ep reales.
+        batch = make_batch(512, 8, [(0,), (511,)])
+        ids = T(T(r) for r in batch[0])
+        self.fixed.calls.clear()
+        out = self.fixed.run(512, 2, 1, batch, ids=ids)
+        (call,) = self.fixed.calls
+        self.assertIs(call["token_selected_experts"], ids)
+        self.assertEqual((call["ep_size"], call["ep_rank"]), (2, 1))
+        self.assertEqual(out, self.raw.run(512, 2, 1, batch))
+
+    def test_patch_idempotent(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            target = make_site(tmp, self.fixture)
+            first = run_block(tmp, self.block)
+            after_first = target.read_bytes()
+            second = run_block(tmp, self.block)
+            self.assertEqual((first.returncode, first.stdout.strip()), (0, f"{MARKER} aplicado"))
+            self.assertEqual((second.returncode, second.stdout.strip()), (0, f"{MARKER} ya aplicado"))
+            self.assertEqual(target.read_bytes(), after_first)
+
+    def test_ep_uneven_exit_on_missing_pattern_tp3(self):
+        changed = self.fixture.replace(ANCHOR, ANCHOR.replace("_ =", "out ="))
+        for tp, experts in ((3, 512), (6, 512), (2, 511)):
+            with self.subTest(tp=tp, experts=experts), tempfile.TemporaryDirectory() as tmp:
+                target = make_site(tmp, changed)
+                done = run_block(tmp, self.block, tp=tp, experts=experts)
+                self.assertEqual(done.returncode, 1)
+                self.assertIn(f"{MARKER} ABORTA: patron no encontrado", done.stderr)
+                self.assertEqual(target.read_text(), changed)
+
+    def test_tp2_even_is_inert_byte_identical(self):
+        for source in (self.fixture, self.fixture.replace(ANCHOR, "")):
+            with tempfile.TemporaryDirectory() as tmp:
+                target = make_site(tmp, source)
+                before = target.read_bytes()
+                done = run_block(tmp, self.block, tp=2, experts=512)
+                self.assertEqual((done.returncode, done.stdout.strip()), (0, f"{MARKER} inerte (E=512, ep=2)"))
+                self.assertEqual(target.read_bytes(), before)
+
+    def test_tp2_with_uneven_experts_applies(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            target = make_site(tmp, self.fixture)
+            done = run_block(tmp, self.block, tp=2, experts=511)
+            self.assertEqual((done.returncode, done.stdout.strip()), (0, f"{MARKER} aplicado"))
+            self.assertEqual(target.read_text(), self.patched)
+
+    def test_anchor_count_is_one_on_fixture(self):
+        self.assertEqual(self.fixture.count(ANCHOR), 1)
+        self.assertEqual(
+            hashlib.sha256(FIXTURE.read_bytes()).hexdigest(),
+            "52887cec5fe628e0a4e7793deb546b40f6c29f7362b3b436c10ca36934ab9826",
+        )
+
+    def test_uneven_with_expert_map_none_raises(self):
+        batch = make_batch(512, 8, [])
+        with self.assertRaisesRegex(RuntimeError, MARKER):
+            self.fixed.run(512, 3, 2, batch, expert_map=None)
+
+    def test_remapped_ids_stay_valid_and_nonlocal_land_outside_own_range(self):
+        num_experts, topk, forced = CASES[0]
+        batch = make_batch(num_experts, topk, forced)
+        for rank in range(3):
+            with self.subTest(rank=rank):
+                n, g_start = split(num_experts, 3, rank)
+                start, total = rank * n, n * 3  # lo que el binding deriva de n_local
+                self.fixed.calls.clear()
+                me = self.fixed.experts(num_experts, 3, rank)
+                self.fixed.log.seek(0)
+                self.fixed.log.truncate()
+                self.fixed.run(num_experts, 3, rank, batch, me=me)
+                self.fixed.run(num_experts, 3, rank, batch, me=me)
+                # una sola linea por instancia aunque haya dos llamadas
+                self.assertEqual(self.fixed.log.getvalue().count(f"{MARKER} activo"), 1)
+                for call in self.fixed.calls:
+                    for row, mapped in zip(batch[0], call["token_selected_experts"]):
+                        for g, m in zip(row, mapped):
+                            self.assertTrue(0 <= m < total)
+                            if g_start <= g < g_start + n:
+                                self.assertEqual(m, start + g - g_start)
+                            else:
+                                self.assertFalse(start <= m < start + n)
+
+
+if __name__ == "__main__":
+    unittest.main()
