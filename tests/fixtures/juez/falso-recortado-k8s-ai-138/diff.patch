+#!/usr/bin/env python3
+"""Parches TP=3 de `launch.sh` (DGX-780): QWEN_TP3_MTP_FC_REPLICATED y QWEN_TP3_VOCAB_MASK.
+
+Los bloques que se ejecutan son los REALES, sacados del ConfigMap `qwen38-flash-next-vllm-launch`
+con `yaml.safe_load_all` y corridos por `python3 -` contra copias congeladas de los ficheros de la
+imagen vLLM 0.28.1rc1.dev628 (96b234af). `mtp.py` se parchea antes con el `patch_mtp` real de
+ursucipian, porque en el pod `install.py` corre antes que estos bloques. Sin GPU, torch ni vLLM:
+el `_apply_head` parcheado se carga por `ast` y corre con un tensor falso.
+
+Con TP=2 los tres bloques TP=3 (este fichero y QWEN_FI_EP_UNEVEN) no abren el fichero de la
+imagen: se prueba byte a byte. Con tp % 3 == 0 y sin patron, salen con 1.
+"""
+
+import ast
+import hashlib
+import importlib.util
+import json
+import os
+import re
+import subprocess
+import sys
+import tempfile
+import types
+import unittest
+from pathlib import Path
+
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+MANIFEST = ROOT / "k8s/qwen38-flash-next-nvfp4-vllm.yaml"
+FIXTURES = ROOT / "tools/fixtures"
+URSU_PATCH = ROOT / "k8s/qwen38-flash-next-ursucipian-mod/refusal/patch_vllm_qwen38next.py"
+FILES = {  # marcador -> (fichero en la imagen, copia congelada, sha256 de la imagen 96b234af)
+    "QWEN_FI_EP_UNEVEN": (
+        "model_executor/layers/fused_moe/experts/flashinfer_cutlass_moe.py",
+        "flashinfer_cutlass_moe.vllm-0.28.1rc1.dev628.py",
+        "52887cec5fe628e0a4e7793deb546b40f6c29f7362b3b436c10ca36934ab9826",
+    ),
+    "QWEN_TP3_MTP_FC_REPLICATED": (
+        "models/qwen4_exp/nvidia/mtp.py",
+        "mtp.vllm-0.28.1rc1.dev628.py",
+        "928c450001ee42cae9f6b0d5e9dc477b63019af2e90baa77505659ea3334eb88",
+    ),
+    "QWEN_TP3_VOCAB_MASK": (
+        "model_executor/layers/logits_processor.py",
+        "logits_processor.vllm-0.28.1rc1.dev628.py",
+        "6b0603d67b0c756253c2fdc882a3896d2e873a16e9aa2ef877aabca8d36bdb5f",
+    ),
+}
+TP2_CONFIG = {"num_experts": 512, "vocab_size": 248320}
+TP3_CONFIG = {"num_experts": 512, "vocab_size": 248448, "tp3_orig_vocab_size": 248320}
+PER_RANK = 248448 // 3  # 82816
+NEG_INF = -float("inf")
+
+
+def launch_sh():
+    with open(MANIFEST, encoding="utf-8") as fh:
+        cm = next(
+            d
+            for d in yaml.safe_load_all(fh)
+            if d and d.get("kind") == "ConfigMap" and d["metadata"]["name"] == "qwen38-flash-next-vllm-launch"
+        )
+    return cm["data"]["launch.sh"]
+
+
+def launch_block(marker):
+    blocks = [b for b in re.findall(r"python3 - <<'PYEOF'\n(.*?)\nPYEOF", launch_sh(), re.S) if marker in b]
+    assert len(blocks) == 1, f"se esperaba un bloque {marker}, hay {len(blocks)}"
+    return blocks[0] + "\n"
+
+
+def image_source(marker):
+    """El fichero que el bloque ve en el pod: el de la imagen, y mtp.py ya con ursucipian."""
+    _, fixture, _ = FILES[marker]
+    source = (FIXTURES / fixture).read_text()
+    if marker != "QWEN_TP3_MTP_FC_REPLICATED":
+        return source
+    spec = importlib.util.spec_from_file_location("ursu_patch_qwen38next", URSU_PATCH)
+    ursu = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(ursu)
+    with tempfile.TemporaryDirectory() as tmp:
+        target = Path(tmp) / FILES[marker][0]
+        target.parent.mkdir(parents=True)
+        target.write_text(source)
+        ursu.patch_mtp(Path(tmp))
+        return target.read_text()
+
+
+def run_block(marker, source, tp, config):
+    """Corre el bloque con QWEN_TP_SIZE y MODEL_PATH como launch.sh; devuelve (proceso, fichero)."""
+    tmp = tempfile.TemporaryDirectory()
+    root = Path(tmp.name)
+    target = root / "vllm" / FILES[marker][0]
+    target.parent.mkdir(parents=True)
+    (root / "vllm/__init__.py").write_text("")
+    target.write_text(source)
+    (root / "model").mkdir()
+    (root / "model/config.json").write_text(json.dumps({"text_config": config}))
+    done = subprocess.run(
+        [sys.executable, "-"],
+        input=launch_block(marker),
+        text=True,
+        capture_output=True,
+        env={**os.environ, "PYTHONPATH": str(root), "QWEN_TP_SIZE": str(tp), "MODEL_PATH": str(root / "model")},
+        cwd=root,
+        check=False,
+    )
+    return done, target, tmp
+
+
+class Matrix(list):
+    """Tensor 2-D falso: filas de floats; `t[..., a:b]` lee o escribe columnas."""
+
+    @property
+    def shape(self):
+        return (len(self), len(self[0]))
+
+    def __getitem__(self, key):
+        if isinstance(key, tuple) and key[0] is Ellipsis:
+            return Matrix(row[key[1]] for row in self)
+        return list.__getitem__(self, key)
+
+    def __setitem__(self, key, value):
+        if isinstance(key, tuple) and key[0] is Ellipsis:
+            for row in self:
+                row[key[1]] = [value] * len(row[key[1]])
+            return
+        list.__setitem__(self, key, value)
+
+
+def logits_processor(source):
+    """`_apply_head` y `_get_logits` de LogitsProcessor (parcheado o no) con torch falso."""
+
+    class Unquantized:
+        pass
+
+    def linear(x, w, b):
+        return Matrix(list(w.rows[0]) for _ in x)  # cada token, los logits de su fila de pesos
+
+    env = {
+        "torch": types.SimpleNamespace(float32="float32"),
+        "F": types.SimpleNamespace(linear=linear),
+        "current_platform": types.SimpleNamespace(is_cuda=lambda: False, is_rocm=lambda: False),
+        "UnquantizedEmbeddingMethod": Unquantized,
+        "UnquantizedLinearMethod": Unquantized,
+    }
+    cls = next(n for n in ast.parse(source).body if isinstance(n, ast.ClassDef) and n.name == "LogitsProcessor")
+    module = ast.parse("from __future__ import annotations")
+    module.body += [n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name.startswith(("_apply_head", "_qwen", "_get_logits"))]
+    exec(compile(module, "<LogitsProcessor>", "exec"), env)
+    methods = {k: v for k, v in env.items() if k.startswith(("_apply_head", "_qwen", "_get_logits"))}
+    return type("FakeLogitsProcessor", (), methods), Unquantized
+
+
+def lm_head_rank(rank, unquantized, real_logit=-1.0):
+    """El rango `rank` de ParallelLMHead a tp=3: las filas reales dan `real_logit`; las de relleno
+    del checkpoint (ids >= 248320) son cero, asi que dan logit 0."""
+    start = rank * PER_RANK
+    row = [real_logit if start + j < 248320 else 0.0 for j in range(PER_RANK)]
+    weight = types.SimpleNamespace(rows=[row], to=lambda dtype: weight)
+    return types.SimpleNamespace(
+        shard_indices=types.SimpleNamespace(org_vocab_start_index=start),
+        tp_size=3,
+        weight=weight,
+        quant_method=types.SimpleNamespace(
+            apply=lambda layer, hidden, bias=None: Matrix([list(row)] * len(hidden))
+        ),
+        unquantized=unquantized,
+    )
+
+
+class Hidden(list):
+    """hidden_states falsos: solo el numero de tokens cuenta."""
+
+    dtype, is_cuda = "bfloat16", False
+
+    def to(self, _dtype):
+        return self
+
+
+def gathered_logits(source, head_dtype=None):
+    """Lo que `_get_logits` devuelve en el rango 0 tras el gather de los tres rangos (dos tokens)."""
+    cls, unquantized = logits_processor(source)
+    heads = [lm_head_rank(r, unquantized) for r in range(3)]
+    for head in heads:
+        if head_dtype:
+            head.quant_method = unquantized()
+    parts = []
+
+    def gather(_self, logits):
+        parts.append(logits)
+        if len(parts) < 3:
+            return None
+        return Matrix(sum((p[i] for p in parts), []) for i in range(len(parts[0])))
+
+    cls._gather_logits = gather
+    out = None
+    for head in heads:
+        lp = cls()
+        lp.head_dtype, lp.org_vocab_size = head_dtype, 248448
+        out = lp._get_logits(Hidden([[0.5], [0.25]]), head, None)
+    return out
+
+
+class Tp3PatchesTest(unittest.TestCase):
+    def test_fixtures_are_the_image_files(self):
+        for marker, (_, fixture, digest) in FILES.items():
+            with self.subTest(marker=marker):
+                self.assertEqual(hashlib.sha256((FIXTURES / fixture).read_bytes()).hexdigest(), digest)
+
+    def test_tp_size_read_from_args(self):
+        text = launch_sh()
+        lines = [ln for ln in text.splitlines() if "QWEN_TP_SIZE" in ln and not ln.lstrip().startswith(("#", "tp ="))]
+        self.assertEqual([ln.split()[0] for ln in lines[:2]], ["export", "QWEN_TP_SIZE=$(printf"])
+        self.assertIn("  --tensor-parallel-size 2\n", text)
+        self.assertLess(text.index("ARGS=("), text.index(lines[1]))
+        for marker in FILES:
+            self.assertLess(text.index(lines[1]), text.index(launch_block(marker)))
+            self.assertLess(text.index("python3 /tmp/ursu-bundle/install.py"), text.index(launch_block(marker)))
+        for tp in ("2", "3"):
+            script = ("set -euo pipefail\nARGS=(/m --revision r --tensor-parallel-size %s --nnodes 3 --x)\n%s\n"
+                      'python3 -c "import os; print(os.environ[\'QWEN_TP_SIZE\'])"\n') % (tp, "\n".join(lines[:2]))
+            done = subprocess.run(["bash", "-c", script], capture_output=True, text=True, check=False)
+            self.assertEqual((done.returncode, done.stdout.strip()), (0, tp), done.stderr)
+
+    def test_patches_inert_tp2_byte_identical(self):
+        for marker in FILES:
+            original = image_source(marker)
+            for source in (original, "# imagen nueva sin ningun patron\n"):
+                with self.subTest(marker=marker, anchors=source is original):
+                    done, target, tmp = run_block(marker, source, 2, TP2_CONFIG)
+                    with tmp:
+                        self.assertEqual(done.returncode, 0, done.stderr)
+                        self.assertIn(f"{marker} inerte", done.stdout)
+                        self.assertEqual(target.read_bytes(), source.encode())
+
+    def test_tp3_missing_pattern_exits_1(self):
+        for marker in ("QWEN_TP3_MTP_FC_REPLICATED", "QWEN_TP3_VOCAB_MASK"):
+            with self.subTest(marker=marker):
+                source = "# imagen nueva sin ningun patron\n"
+                done, target, tmp = run_block(marker, source, 3, TP3_CONFIG)
+                with tmp:
+                    self.assertEqual(done.returncode, 1)
+                    self.assertIn(f"{marker} ABORTA: patron no encontrado", done.stderr)
+                    self.assertEqual(target.read_text(), source)
+
+    def test_mtp_fc_replicated_only_tp3(self):
+        marker = "QWEN_TP3_MTP_FC_REPLICATED"
+        source = image_source(marker)
+        self.assertIn("_refusal.project_hc(", source)  # ursucipian ya paso por el fichero
+        done, target, tmp = run_block(marker, source, 3, TP3_CONFIG)
+        with tmp:
+            self.assertEqual((done.returncode, done.stdout.strip()), (0, f"{marker} aplicado"), done.stderr)
+            patched = target.read_text()
+            again = subprocess.run(
+                [sys.executable, "-"], input=launch_block(marker), text=True, capture_output=True, check=False,
+                env={**os.environ, "PYTHONPATH": str(target.parents[4]), "QWEN_TP_SIZE": "3",
+                     "MODEL_PATH": str(target.parents[4] / "model")},
+            )
+            self.assertEqual((again.returncode, again.stdout.strip()), (0, f"{marker} ya aplicado"))
+            self.assertEqual(target.read_text(), patched)
+        calls = {}
+        for node in ast.walk(ast.parse(patched)):
+            if isinstance(node, ast.Assign) and isinstance(node.value, ast.Call):
+                for t in node.targets:
+                    if isinstance(t, ast.Attribute) and t.attr in ("fc_embedding", "fc_hidden"):
+                        calls[t.attr] = node.value
+        self.assertEqual(sorted(calls), ["fc_embedding", "fc_hidden"])
+        for name, call in calls.items():
+            self.assertEqual(call.func.id, "ReplicatedLinear", name)
+            # argumentos que acepta ReplicatedLinear (linear.py:340-350 de la imagen)
+            self.assertLessEqual({k.arg for k in call.keywords}, {"bias", "return_bias", "quant_config", "prefix"})
+            self.assertEqual(len(call.args), 2)
+        self.assertIn("from vllm.model_executor.layers.linear import ColumnParallelLinear, ReplicatedLinear", patched)
+        # el resto del fichero (la proyeccion de refusal del forward incluida) no cambia
+        restored = patched.replace("ColumnParallelLinear, ReplicatedLinear  # QWEN_TP3_MTP_FC_REPLICATED\n",
+                                   "ColumnParallelLinear\n")
+        for name in calls:
+            restored = restored.replace(
+                f"            # QWEN_TP3_MTP_FC_REPLICATED (DGX-780): 2560 no se parte en 3\n"
+                f"            self.{name} = ReplicatedLinear(\n                self.hidden_size,\n                self.hidden_size,\n",
+                f"            self.{name} = ColumnParallelLinear(\n                self.hidden_size,\n                self.hidden_size,\n"
+                "                gather_output=True,\n")
+        self.assertEqual(restored, source)
+        done, target, tmp = run_block(marker, source, 2, TP2_CONFIG)
+        with tmp:
+            self.assertEqual(target.read_text(), source)
