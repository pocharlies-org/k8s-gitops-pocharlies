+def nccl_src():
+    """El checkout de NCCL v2.30.7-1 que apunta NCCL_SRC, comprobado contra el commit que fija el Dockerfile."""
+    src = Path(os.environ["NCCL_SRC"])
+    head = subprocess.run(["git", "-C", str(src), "rev-parse", "HEAD"], check=True, capture_output=True, text=True).stdout.strip()
+    assert head == NCCL_COMMIT, head
+    return src
+
+
+def paquetes_apt(dockerfile):
+    """Los paquetes del `apt-get install` de la etapa de build."""
+    build = dockerfile.split("\nFROM ")[1].replace("\\\n", " ")
+    return {p for p in re.search(r"apt-get install ([^&;]+)", build).group(1).split() if not p.startswith("-")}
