+    @unittest.skipUnless(os.environ.get("NCCL_SRC"), "NCCL_SRC: checkout de NVIDIA/nccl en v2.30.7-1 (73cf1122)")
+    def test_los_interpretes_que_ejecuta_el_build_de_nccl_estan_en_el_apt_get(self):
+        # Los Makefile de src.build llaman a `./<ruta>.py`: el shebang de cada uno es el intérprete que la imagen debe traer, y sus
+        # imports, módulos de la librería estándar (lo único que instala el paquete python3).
+        src = nccl_src()
+        paquetes = {"python3": "python3"}  # intérprete -> paquete; bash y sh vienen en la base
+        scripts = {}
+        for mk in [src / "Makefile", src / "src/Makefile", src / "src/device/Makefile", *(src / "makefiles").glob("*.mk")]:
+            for ruta in re.findall(r"(?<![\w./$])\./([\w./-]+\.py)\b", mk.read_text(encoding="utf-8")):
+                scripts[(mk.parent / ruta).resolve()] = mk
+        self.assertLessEqual({"src/misc/generate_git_version.py", "src/device/generate.py", "src/device/symmetric/generate.py"},
+                             {str(s.relative_to(src.resolve())) for s in scripts})  # el patrón no se queda ciego
+        instalados = paquetes_apt(self.docker)
+        for script in scripts:
+            with self.subTest(script=script.name):
+                shebang = script.read_text(encoding="utf-8").splitlines()[0]
+                interprete = shebang.removeprefix("#!").split()[-1].rsplit("/", 1)[-1]
+                self.assertIn(interprete, paquetes, f"{shebang}: intérprete sin paquete conocido")
+                self.assertIn(paquetes[interprete], instalados)
+                imports = [n for n in ast.walk(ast.parse(script.read_text(encoding="utf-8"))) if isinstance(n, (ast.Import, ast.ImportFrom))]
+                modulos = {a.name.split(".")[0] for n in imports if isinstance(n, ast.Import) for a in n.names}
+                modulos |= {(n.module or "").split(".")[0] for n in imports if isinstance(n, ast.ImportFrom)}
+                self.assertLessEqual(modulos, sys.stdlib_module_names)
+
