diff --git a/tools/test_nccl_ring.py b/tools/test_nccl_ring.py
index 77b7b38..0e8691a 100644
--- a/tools/test_nccl_ring.py
+++ b/tools/test_nccl_ring.py
@@ -222,6 +222,22 @@ def test_se_compila_solo_para_sm_121_y_solo_arm64(self):
         self.assertIn("cuobjdump --list-elf", self.docker)
         self.assertIn("--platform linux/arm64", self.texto)
 
+    def test_la_comprobacion_de_cubin_acepta_exactamente_sm_121_y_sm_100(self):
+        # el Makefile de NCCL fuerza sm_100 (LDMC FP8) aunque se pase NVCC_GENCODE: el run 38063874568 llegó a libnccl.so.2 y cayó aquí
+        self.assertIn("src/device/Makefile:48", self.docker)
+        self.assertIn("grep -q sm_121 /tmp/elf.txt;", self.docker)  # sm_121 tiene que estar; sm_100 solo se tolera
+        linea = re.search(r"(?m)^\s*(if grep -oE .*; fi);", self.docker).group(1)
+
+        def con_fichero(archs):
+            with tempfile.TemporaryDirectory() as d:
+                (Path(d) / "elf.txt").write_text("".join(f"ELF file {i}: libnccl.so.{i}.{a}.cubin\n" for i, a in enumerate(archs, 1)))
+                return subprocess.run(["bash", "-c", linea.replace("/tmp/elf.txt", f"{d}/elf.txt")], check=False).returncode == 0
+
+        self.assertTrue(con_fichero(["sm_121"]))
+        self.assertTrue(con_fichero(["sm_121", "sm_100", "sm_121", "sm_100"]))
+        for otra in ("sm_90", "sm_120", "sm_100f", "sm_80"):
+            self.assertFalse(con_fichero(["sm_121", "sm_100", otra]), otra)
+
     def test_la_imagen_final_es_scratch_con_la_lib_el_generador_y_ring_conf(self):
         final = self.docker.split("\nFROM ")[-1]
         self.assertTrue(final.startswith("scratch"))
