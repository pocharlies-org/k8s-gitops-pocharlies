+@pytest.fixture
+def curl_argv(tmp_path):
+    """Un `curl` delante en el PATH que anota los argumentos y delega en el de verdad."""
+    real = shutil.which("curl")
+    if not real:
+        pytest.skip("sin curl")
+    log = tmp_path / "curl-argv"
+    stub = tmp_path / "bin" / "curl"
+    stub.parent.mkdir()
+    stub.write_text(f'#!/bin/sh\nprintf \'%s\\n\' "$@" >> {log}\nexec {real} "$@"\n')
+    stub.chmod(0o755)
+    return stub.parent, log
+
+
+def run_script(connector_url, tmp_path, summary, *, keyfile, path_prefix=None, extra=()):
+    env = {
+        **os.environ,
+        "CONNECTOR_URL": connector_url,
+        "CONNECTOR_SECRET_FILE": str(keyfile),
+        "CONNECTOR_SECRET_OWNER": ME,
+    }
+    if path_prefix:
+        env["PATH"] = f"{path_prefix}:{env['PATH']}"
+    return subprocess.run(
+        [BASH, str(SCRIPT), "--status", "warn", "--node", "x86", "--summary", summary, *extra],
+        capture_output=True,
+        text=True,
+        env=env,
+    )
+
+
+def test_el_script_firma_lo_que_envia_y_el_conector_lo_acepta(connector, tmp_path, curl_argv):
+    bin_dir, argv_log = curl_argv
+    # DEL, emoji, comillas, una barra con `u007f` escrito a mano y un salto de línea: el caso que jq rompería.
+    summary = 'apt: 3 paquetes\x7f 👍🏽 "q" \\u007f\nfin'
+    p = run_script(connector.url, tmp_path, summary, keyfile=key_file(tmp_path), path_prefix=bin_dir,
+                   extra=["--reboot-pending"])
+    assert p.returncode == 0, p.stderr
+    assert p.stdout.startswith("Sent: ⚠️ x86: apt: 3 paquetes")
+    (req,) = connector.requests
+    assert req["path"] == f"/api/public/send/{CHAT}"
+    assert req["valid"], "el conector rechazaría la firma"
+    assert req["canonical_is_raw"], "el cuerpo enviado no es lo que reescribiría JSON.stringify"
+    assert b"\x7f" in req["raw"] and b"\\u007f" not in req["raw"].replace(b"\\\\u007f", b"")
+    sent = json.loads(req["raw"])
+    assert sent["topicId"] == 1248 and sent["text"].endswith(" · REBOOT pendiente") and "\x7f" in sent["text"]
+    # La clave no sale ni por la salida, ni por el error, ni por la línea de comandos de curl.
+    assert KEY not in p.stdout + p.stderr
+    argv = argv_log.read_text()
+    assert KEY not in argv and req["sig"] in argv
+
+
+def test_sin_fichero_de_clave_avisa_y_envia_sin_firma(connector, tmp_path):
+    p = run_script(connector.url, tmp_path, "todo bien", keyfile=tmp_path / "no-existe")
+    assert p.returncode == 0, p.stderr
+    assert "WARN: no connector key" in p.stderr
+    (req,) = connector.requests
+    assert (req["ts"], req["sig"]) == (None, None)
+
+
+def test_un_fichero_de_clave_con_permisos_de_mas_no_envia_nada(connector, tmp_path):
+    p = run_script(connector.url, tmp_path, "todo bien", keyfile=key_file(tmp_path, mode=0o644))
+    assert p.returncode == 1
+    assert "mode 600" in p.stderr and KEY not in p.stdout + p.stderr
+    assert connector.requests == []
+
+
+def test_un_rechazo_del_conector_se_ve_en_el_error_y_sale_con_1(tmp_path):
+    c = FakeConnector(status=401, reply=b'{"error":"Invalid signature"}')
+    try:
+        p = run_script(c.url, tmp_path, "todo bien", keyfile=key_file(tmp_path))
+    finally:
+        c.close()
+    assert p.returncode == 1
+    assert "Connector response" in p.stderr and "Invalid signature" in p.stderr
+    assert KEY not in p.stdout + p.stderr
+
