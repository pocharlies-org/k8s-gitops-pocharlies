@@ -0,0 +1,280 @@
+"""SKIRM-111 (C3): `notify-synapse-monitor.sh` firma sus envíos al conector de Telegram.
+
+El conector verifica `sha256=HMAC(clave, "<ts>:" + JSON.stringify(cuerpo parseado))`. El script firma los bytes
+EXACTOS que envía, y esos bytes son los que escribiría `JSON.stringify` (compactos, DEL y no ASCII en crudo): `jq`
+escribe DEL como `\\u007f` y la firma no casaría, en silencio, con un mensaje que lo llevara.
+
+Estas pruebas no tocan la red ni el clúster: el conector es un servidor local que hace la misma comprobación y la
+clave es una de prueba. Los vectores son los literales de `connectors/telegram/src/api/public-routes.test.ts` de
+`pocharlies-org/k8s-socialmedia-pocharlies` (SKIRM-111), los mismos que asserta `telegram-sync`: si el firmador
+deriva, esos literales lo dicen.
+"""
+import hashlib
+import hmac
+import json
+import os
+import pwd
+import shutil
+import stat
+import subprocess
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+SCRIPT = ROOT / "services" / "monitoring" / "scripts" / "notify-synapse-monitor.sh"
+BASH = shutil.which("bash")
+NODE = shutil.which("node")
+try:
+    ME = pwd.getpwuid(os.getuid()).pw_name
+except KeyError:  # el script compara el propietario por nombre: sin entrada en passwd no hay nada que probar
+    pytest.skip("el uid actual no tiene entrada en passwd", allow_module_level=True)
+
+KEY = "vector-secret-not-a-real-key"
+TS = "1760000000"
+CHAT = "-1004409526898"
+
+# (texto, topicId o "", firma): el cuerpo del conector `{ text, topicId? }` serializado con JSON.stringify.
+VECTORS = [
+    ("hola", "", "sha256=afcb691954c420b230066c0959302dd152b62921ec75013c6811b19b6f7f6ddc"),
+    (
+        'ñandú ☃ "q" \\ \n\t línea',
+        "42",
+        "sha256=c92ca6dc3907aaa9cd70640b6a66253bde649d6476b9deadcb017a628e0fc44d",
+    ),
+    ("hola 👍🏽", "", "sha256=267114fcccf55614d21e00f4b3b58281f134a9310c6179435a700740a03d56d6"),
+]
+EMPTY_BODY_VECTOR = "sha256=9c13b5d911180ca8afe1a2f4e6d7da93068aca9168ddb0d0e66781915f2a76af"
+
+
+def hmac_sha256(key: str, ts: str, body: str) -> str:
+    return "sha256=" + hmac.new(key.encode(), f"{ts}:{body}".encode(), hashlib.sha256).hexdigest()
+
+
+def key_file(tmp_path, content=KEY, mode=0o600):
+    path = tmp_path / "connector-secret"
+    path.write_text(content)
+    path.chmod(mode)
+    return path
+
+
+def sign_request(text, topic, keyfile, owner=ME, ts=TS):
+    """Llama a la función del script (sourced) y devuelve (rc, ts, firma, cuerpo, stderr)."""
+    p = subprocess.run(
+        [BASH, "-c", 'source "$1"; shift; sign_request "$@"', "_", str(SCRIPT), text, topic, str(keyfile), owner, ts],
+        capture_output=True,
+    )
+    if p.returncode != 0:
+        return p.returncode, None, None, None, p.stderr.decode()
+    got_ts, sig, body = p.stdout.split(b"\n", 2)
+    return 0, got_ts.decode(), sig.decode(), body, p.stderr.decode()
+
+
+def test_el_firmador_de_prueba_coincide_con_el_vector_del_cuerpo_vacio():
+    assert hmac_sha256(KEY, TS, "{}") == EMPTY_BODY_VECTOR
+
+
+@pytest.mark.parametrize("text,topic,expected", VECTORS)
+def test_vectores_del_conector(tmp_path, text, topic, expected):
+    rc, ts, sig, body, err = sign_request(text, topic, key_file(tmp_path))
+    assert rc == 0, err
+    assert (ts, sig) == (TS, expected)
+    assert hmac_sha256(KEY, TS, body.decode()) == expected  # lo firmado son los bytes devueltos
+
+
+def test_el_cuerpo_es_lo_que_escribe_json_stringify(tmp_path):
+    # DEL y U+2028 en crudo (jq escribiría \u007f), controles en \u00xx minúscula, y un `\u007f` escrito a mano
+    # en el texto sigue siendo texto: la barra se duplica.
+    text = 'a\x7fb\u2028c\x1fd\\u007f"'
+    rc, _, _, body, err = sign_request(text, "1248", key_file(tmp_path))
+    assert rc == 0, err
+    assert body == ('{"text":"a\x7fb\u2028c\\u001fd\\\\u007f\\"","topicId":1248}').encode()
+    assert b"\x7f" in body and b"\\u007f" not in body.replace(b"\\\\u007f", b"")
+
+
+@pytest.mark.skipif(not NODE, reason="sin node no hay JSON.stringify con el que cotejar")
+def test_cuerpo_identico_a_json_stringify_en_todo_el_plano_basico(tmp_path):
+    # Todos los puntos de código de U+0001 a U+2FFF (menos sustitutos, que no hay en UTF-8) más emoji, en un texto.
+    text = "".join(chr(c) for c in range(1, 0x3000) if not 0xD800 <= c <= 0xDFFF) + "👍🏽😀"
+    rc, _, _, body, err = sign_request(text, "1248", key_file(tmp_path))
+    assert rc == 0, err
+    js = subprocess.run(
+        [NODE, "-e", 'process.stdout.write(JSON.stringify({text: process.argv[1], topicId: 1248}))', text],
+        capture_output=True,
+        check=True,
+    )
+    assert body == js.stdout
+
+
+def test_la_clave_con_salto_de_linea_final_firma_igual(tmp_path):
+    rc, _, sig, _, err = sign_request("hola", "", key_file(tmp_path, KEY + "\n"))
+    assert rc == 0, err
+    assert sig == VECTORS[0][2]
+
+
+def test_sin_fichero_de_clave_no_hay_firma_pero_si_cuerpo(tmp_path):
+    rc, ts, sig, body, err = sign_request("hola", "1248", "")
+    assert (rc, ts, sig, body) == (0, "", "", b'{"text":"hola","topicId":1248}')
+
+
+@pytest.mark.parametrize(
+    "what,mode,content,owner",
+    [
+        ("modo 644", 0o644, KEY, ME),
+        ("modo 640", 0o640, KEY, ME),
+        ("modo 400", 0o400, KEY, ME),
+        ("otro propietario", 0o600, KEY, "nadie-lo-es"),
+        ("vacío", 0o600, "", ME),
+        ("solo salto de línea", 0o600, "\n", ME),
+    ],
+)
+def test_un_fichero_de_clave_que_no_vale_se_rechaza_sin_imprimir_la_clave(tmp_path, what, mode, content, owner):
+    rc, _, _, _, err = sign_request("hola", "", key_file(tmp_path, content, mode), owner)
+    assert rc != 0, what
+    assert KEY not in err
+
+
+def test_un_directorio_o_un_enlace_roto_no_valen_como_clave(tmp_path):
+    assert sign_request("hola", "", tmp_path)[0] != 0
+    (tmp_path / "roto").symlink_to(tmp_path / "no-existe")
+    assert sign_request("hola", "", tmp_path / "roto")[0] != 0
+
+
+# ---- El script entero contra un conector de mentira que verifica como createHMACAuth -------------------------------
+
+
+class FakeConnector:
+    """Verifica como la puerta del conector: ventana de 5 min y HMAC de `<ts>:<JSON.stringify(cuerpo parseado)>`."""
+
+    def __init__(self, status=200, reply=b'{"success":true}'):
+        self.requests = []
+        outer = self
+
+        class Handler(BaseHTTPRequestHandler):
+            def do_POST(self):
+                raw = self.rfile.read(int(self.headers["Content-Length"]))
+                ts, sig = self.headers.get("x-connector-timestamp"), self.headers.get("x-connector-signature")
+                canonical = json.dumps(json.loads(raw), ensure_ascii=False, separators=(",", ":"))
+                outer.requests.append(
+                    {
+                        "path": self.path,
+                        "raw": raw,
+                        "ts": ts,
+                        "sig": sig,
+                        "valid": bool(ts and sig)
+                        and abs(time.time() - int(ts)) <= 300
+                        and hmac.compare_digest(sig, hmac_sha256(KEY, ts, canonical)),
+                        "canonical_is_raw": canonical.encode() == raw,
+                    }
+                )
+                self.send_response(status)
+                self.send_header("Content-Length", str(len(reply)))
+                self.end_headers()
+                self.wfile.write(reply)
+
+            def log_message(self, *args):
+                pass
+
+        self.server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        self.url = f"http://127.0.0.1:{self.server.server_address[1]}"
+        threading.Thread(target=self.server.serve_forever, daemon=True).start()
+
+    def close(self):
+        self.server.shutdown()
+        self.server.server_close()
+
+
+@pytest.fixture
+def connector():
