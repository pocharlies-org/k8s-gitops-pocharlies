+#!/usr/bin/env python3
+"""Clasifica una PR por las lineas que cambia (SC-9004)."""
+
+LIMITE_CHICA = 80
+LIMITE_MEDIA = 300
+
+
+def clasificar(lineas):
+    """`chica` hasta 50 lineas, `media` hasta 300 y `grande` por encima."""
+    if lineas <= LIMITE_CHICA:
+        return 'chica'
+    return 'media' if lineas <= LIMITE_MEDIA else 'grande'
