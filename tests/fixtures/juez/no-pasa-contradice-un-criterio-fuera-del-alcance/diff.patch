new file mode 100644
index 0000000..2fa1b37
--- /dev/null
+++ b/tests/test_pr_size.py
@@ -0,0 +1,16 @@
+import importlib.util
+import unittest
+from pathlib import Path
+
+spec = importlib.util.spec_from_file_location('pr_size', Path(__file__).resolve().parent.parent / 'scripts/pr-size.py')
+size = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(size)
+
+
+class TestClasificar(unittest.TestCase):
+    def test_los_limites(self):
+        self.assertEqual([size.clasificar(n) for n in (80, 81, 300, 301)], ['chica', 'media', 'media', 'grande'])
+
+
+if __name__ == '__main__':
+    unittest.main()
