+# Los smokes del router (tests/smoke-*.js) en cada PR y en main. Hasta SC-2161 P3 nadie los
+# ejecutaba en CI (ARCHITECTURE.md: «no se verifico que CI los ejecute»), y el desvio de cuenta
+# mueve credenciales: no puede descansar en tests que no corren. Node sin dependencias, fakes
+# locales, sin red ni secretos.
+name: smokes
+
+on:
+  pull_request:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  smokes:
+    # arc-k8s no trae node: lo pone setup-node (skill ci-runners-arc).
+    runs-on: arc-k8s
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: "22"
+      - name: tests/smoke-*.js
+        run: |
+          set -u
+          rc=0
+          for t in tests/smoke-*.js; do
+            echo "::group::$t"
+            node "$t" || { rc=1; echo "::error title=smoke en rojo::$t"; }
+            echo "::endgroup::"
+          done
+          exit $rc
