+class Apagada(Base):
+    """SC-2295: con la compañía apagada (el fichero `apagada` en STATE_DIR) no nace ni se reanuda una sesión de la
+    compañía; lo vivo sigue; las Acciones (ACC, rol secretaria) no cambian."""
+    def setUp(self):
+        super().setUp()
+        self.estado = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, self.estado, True)
+        self.patches_estado = mock.patch.dict(os.environ, {"STATE_DIR": self.estado})
+        self.patches_estado.start()
+        self.addCleanup(self.patches_estado.stop)
+
+    def apagar(self, on=True):
+        ruta = os.path.join(self.estado, "apagada")
+        if on:
+            Path(ruta).touch()
+        else:
+            Path(ruta).unlink(missing_ok=True)
+
+    def test_c1_lanzar_apagada_niega_con_exit_3_antes_de_crear_sid(self):
+        self.apagar()
+        err = io.StringIO()
+        with mock.patch.object(sys, "stdin", io.StringIO("implementa x")), contextlib.redirect_stderr(err):
+            rc = cs.main(["lanzar", "--perfil", "cto", "--rol", "developer", "--key", "SC-1"])
+        self.assertEqual(rc, 3)
+        self.assertIn("compañía apagada", err.getvalue())
+        self.assertEqual(self.jet.lanzadas, [])
+        self.assertIsNone(cs.sesion_de("SC-1", "developer"))
+
+    def test_c2_mensaje_a_sesion_parada_no_la_reanuda_con_la_compania_apagada(self):
+        cs.lanzar("cto", "developer", "SC-1", "a", 0)
+        self.apagar()
+        with self.assertRaises(cs.Negado) as e:
+            cs.mensaje("cto", "developer", "SC-1", "sigue", 0)
+        self.assertIn("compañía apagada", str(e.exception))
+        self.assertEqual(len(self.jet.lanzadas), 1, "la parada no se reanuda")
+
+    def test_c2_mensaje_a_sesion_viva_se_entrega_con_la_compania_apagada(self):
+        cs.lanzar("cto", "developer", "SC-1", "a", 0)
+        sid = cs.sesion_de("SC-1", "developer")["sid"]
+        self.jet.vivas[sid] = "ses-developer-SC-1-x"
+        self.apagar()
+        cs.mensaje("cto", "developer", "SC-1", "qa dice: falla Z", 0)
+        self.assertEqual(self.jet.entregas, [("ses-developer-SC-1-x", "qa dice: falla Z")])
+
+    def test_c4_secretaria_y_acciones_no_cambian_con_la_compania_apagada(self):
+        self.apagar()
+        cs.comprobar_apagada("secretaria", "SC-1", "lanzar")          # rol secretaria: pasa
+        cs.comprobar_apagada("pm", "ACC-3", "lanzar")                 # clave ACC: pasa
+        with self.assertRaises(cs.Negado):
+            cs.comprobar_apagada("developer", "SC-1", "lanzar")       # lo demás: niega
+
+    def test_con_codigos_el_supervisor_lo_ve_como_sin_hueco_y_lo_reintenta(self):
+        self.apagar()
+        with mock.patch.object(sys, "stdin", io.StringIO("x")), contextlib.redirect_stderr(io.StringIO()):
+            rc = cs.main(["lanzar", "--codigos", "--perfil", "cto", "--rol", "developer", "--key", "SC-1"])
+        self.assertEqual(rc, cs.company_encargos.CODIGO_SIN_HUECO)
+
+    def test_sin_fichero_apagada_no_niega_nada(self):
+        cs.lanzar("cto", "developer", "SC-1", "a", 0)
+        self.assertEqual(len(self.jet.lanzadas), 1)
+
+
 if __name__ == "__main__":
     unittest.main()
