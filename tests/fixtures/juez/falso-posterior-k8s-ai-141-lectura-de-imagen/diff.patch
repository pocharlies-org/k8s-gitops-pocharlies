+++ b/k8s/qwen38fn-tp3-jobs.yaml
@@ -0,0 +1,211 @@
+# DGX-780 · checkpoint TP=3 del hibrido qwen38fn-mtp-nvidia-fp8-hybrid (rev 7b719225), SIN GPU.
+#
+#  1. convert (dgx3): sha256sum -c de la copia local de solo lectura (/srv/ai-lab/models/...-7b719225),
+#     convert.py convert (aborta si el config.json no casa o si no hay 1,2x el espacio que escribe; el log
+#     dice cuantos GiB reescribe), install.py de ursucipian (las capas que carga el motor) y convert.py verify
+#     (equivalencia + verify-loaders a tp=3). Compara el SHA256SUMS del origen con el de antes y vuelve a
+#     pasar el sha256sum -c: ningun byte de TP=2 cambia. La marca .built-tp3-7b719225 solo se deja con verify.json PASA.
+#  2. serve (dgx3): HTTP de solo lectura de la vista TP=3 detras del Service ClusterIP qwen38fn-tp3-serve.
+#     Termina cuando publish pide GET /fin; asi el Job queda Complete.
+#  3. publish (nvidia-dgx): espera la marca, exige verify.json PASA y espacio libre en dgx1 (1,2x lo que trae),
+#     trae lo reescrito por la red del CNI (NO es el enlace CX7), enlaza lo demas a la vista hermana con
+#     enlaces relativos, sha256sum -c de la vista entera y renombra de forma atomica a
+#     /home/dibanerz/.cache/huggingface/qwen38fn-mtp-nvidia-fp8-hybrid-tp3.
+#
+# Idempotentes por marca: convert sale 0 con .built-tp3-7b719225, publish con el destino ya renombrado.
+# Sin GPU (NVIDIA_VISIBLE_DEVICES=void, sin nvidia.com/gpu) y sin etiquetas gpu.dgx-infra/*: el arbitro no los
+# cuenta. Sin ttlSecondsAfterFinished a proposito (Argo los recrearia). Un Job no se edita: si hace falta otra
+# pasada, otro nombre (-2) y el prune retira el viejo. El codigo es k8s/qwen38fn-tp3/convert.py (ConfigMap
+# qwen38fn-tp3, configMapGenerator sin sufijo de hash en kustomization.yaml).
+apiVersion: v1
+kind: Service
+metadata:
+  name: qwen38fn-tp3-serve
+  namespace: llm
+  labels:
+    app: qwen38fn-tp3-serve
+spec:
+  type: ClusterIP
+  selector:
+    app: qwen38fn-tp3-serve
+  ports:
+    - { name: http, port: 8080, targetPort: 8080 }
+---
+apiVersion: batch/v1
+kind: Job
+metadata:
+  name: qwen38fn-tp3-convert
+  namespace: llm
+  labels:
+    app: qwen38fn-tp3-convert
+spec:
+  backoffLimit: 2
+  activeDeadlineSeconds: 21600
+  template:
+    metadata:
+      labels:
+        app: qwen38fn-tp3-convert
+    spec:
+      restartPolicy: OnFailure
+      enableServiceLinks: false
+      automountServiceAccountToken: false
+      nodeSelector:
+        kubernetes.io/hostname: dgx3
+      tolerations:
+        - { key: dedicated, operator: Equal, value: llm, effect: NoSchedule }
+      containers:
+        - name: convert
+          image: docker.io/vllm/vllm-openai@sha256:96b234afa2867031ad0a226b149a06483861e613e3a3083da53398d347b5ffbd
+          imagePullPolicy: IfNotPresent
+          command: ["bash", "-c"]
+          args:
+            - |
+              set -euo pipefail
+              SRC=/models/src OUT=/models/tp3
+              MARK="$OUT/.built-tp3-7b719225"
+              if [ -f "$MARK" ]; then echo "QWEN_TP3_CONVERT ya construido: $MARK"; exit 0; fi
+              SUMS_ANTES=$(sha256sum < "$SRC/SHA256SUMS")
+              (cd "$SRC" && sha256sum --check --quiet --strict SHA256SUMS)
+              python3 -I -u /tp3/convert.py convert --src "$SRC" --out "$OUT"
+              # Las capas que carga el motor son las de la imagen con ursucipian encima (launch.sh hace lo mismo).
+              mkdir -p /tmp/ursu-bundle
+              tar -C /opt/ursu --exclude='..*' -chf - . | tar -C /tmp/ursu-bundle -xf -
+              python3 /tmp/ursu-bundle/install.py
+              python3 -I -u /tp3/convert.py verify --src "$SRC" --out "$OUT" --json "$OUT/verify.json"
+              # C2: ningun byte de TP=2 cambia. El SHA256SUMS es el mismo y cada fichero sigue casando con el.
+              if [ "$(sha256sum < "$SRC/SHA256SUMS")" != "$SUMS_ANTES" ]; then
+                echo "QWEN_TP3_CONVERT ABORTA: el SHA256SUMS de TP=2 ha cambiado" >&2
+                exit 1
+              fi
+              (cd "$SRC" && sha256sum --check --quiet --strict SHA256SUMS)
+              echo "QWEN_TP3_CONVERT origen TP=2 intacto: SHA256SUMS igual y sha256sum -c OK antes y despues"
+              : > "$MARK"
+          env:
+            - { name: NVIDIA_VISIBLE_DEVICES, value: "void" }
+          # verify-loaders no materializa la ngram_embedding de un rango (~15,9 GiB FP8): va en meta y carga una
+          # ventana de filas (C-a). Un OOMKill sale como fallo del Job, nunca como PASA (no hay marca).
+          resources:
+            requests: { cpu: "4", memory: 16Gi }
+            limits: { memory: 16Gi }
+          volumeMounts:
+            - { name: src, mountPath: /models/src, readOnly: true }
+            - { name: tp3, mountPath: /models/tp3 }
+            - { name: code, mountPath: /tp3, readOnly: true }
+            - { name: ursu-root, mountPath: /opt/ursu, readOnly: true }
+            - { name: ursu-overlays, mountPath: /opt/ursu/overlays, readOnly: true }
+            - { name: ursu-refusal, mountPath: /opt/ursu/refusal, readOnly: true }
+            - { name: ursu-refusal-payload, mountPath: /opt/ursu/refusal/payload, readOnly: true }
+      volumes:
+        - name: src
+          hostPath: { path: /srv/ai-lab/models/qwen38fn-mtp-nvidia-fp8-hybrid-7b719225, type: Directory }
+        - name: tp3
+          hostPath: { path: /srv/ai-lab/models/qwen38fn-mtp-nvidia-fp8-hybrid-tp3-7b719225, type: DirectoryOrCreate }
+        - name: code
+          configMap: { name: qwen38fn-tp3 }
+        - name: ursu-root
+          configMap: { name: qwen38fn-ursu-root }
+        - name: ursu-overlays
+          projected:
+            sources:
+              - configMap: { name: qwen38fn-ursu-overlays-a }
+              - configMap: { name: qwen38fn-ursu-overlays-b }
+        - name: ursu-refusal
+          configMap: { name: qwen38fn-ursu-refusal }
+        - name: ursu-refusal-payload
+          configMap: { name: qwen38fn-ursu-refusal-payload }
+---
+apiVersion: batch/v1
+kind: Job
+metadata:
+  name: qwen38fn-tp3-serve
+  namespace: llm
+  labels:
+    app: qwen38fn-tp3-serve
+spec:
+  backoffLimit: 6
+  activeDeadlineSeconds: 172800
+  template:
+    metadata:
+      labels:
+        app: qwen38fn-tp3-serve
+    spec:
+      restartPolicy: OnFailure
+      enableServiceLinks: false
+      automountServiceAccountToken: false
+      nodeSelector:
+        kubernetes.io/hostname: dgx3
+      tolerations:
+        - { key: dedicated, operator: Equal, value: llm, effect: NoSchedule }
+      containers:
+        - name: serve
+          image: docker.io/vllm/vllm-openai@sha256:96b234afa2867031ad0a226b149a06483861e613e3a3083da53398d347b5ffbd
+          imagePullPolicy: IfNotPresent
+          command: ["python3", "-I", "-u", "/tp3/convert.py", "serve", "--out", "/models/tp3", "--port", "8080"]
+          env:
+            - { name: NVIDIA_VISIBLE_DEVICES, value: "void" }
+          ports:
+            - { name: http, containerPort: 8080 }
+          resources:
+            requests: { cpu: "1", memory: 1Gi }
+            limits: { memory: 1Gi }
+          volumeMounts:
+            - { name: tp3, mountPath: /models/tp3, readOnly: true }
+            - { name: code, mountPath: /tp3, readOnly: true }
+      volumes:
+        - name: tp3
+          hostPath: { path: /srv/ai-lab/models/qwen38fn-mtp-nvidia-fp8-hybrid-tp3-7b719225, type: DirectoryOrCreate }
+        - name: code
+          configMap: { name: qwen38fn-tp3 }
+---
+apiVersion: batch/v1
+kind: Job
+metadata:
+  name: qwen38fn-tp3-publish
+  namespace: llm
+  labels:
+    app: qwen38fn-tp3-publish
+spec:
+  backoffLimit: 3
+  activeDeadlineSeconds: 172800
+  template:
+    metadata:
+      labels:
+        app: qwen38fn-tp3-publish
+    spec:
+      restartPolicy: OnFailure
+      enableServiceLinks: false
+      automountServiceAccountToken: false
+      nodeSelector:
+        kubernetes.io/hostname: nvidia-dgx
+      tolerations:
+        - { key: dedicated, operator: Equal, value: llm, effect: NoSchedule }
+      containers:
+        - name: publish
+          image: docker.io/vllm/vllm-openai@sha256:96b234afa2867031ad0a226b149a06483861e613e3a3083da53398d347b5ffbd
+          imagePullPolicy: IfNotPresent
+          command:
+            - python3
+            - -I
+            - -u
+            - /tp3/convert.py
+            - publish
+            - --url
+            - http://qwen38fn-tp3-serve.llm.svc.cluster.local:8080
+            - --dest
+            - /hf/qwen38fn-mtp-nvidia-fp8-hybrid-tp3
+            - --sibling
+            - qwen38fn-mtp-nvidia-fp8-hybrid
+          env:
+            - { name: NVIDIA_VISIBLE_DEVICES, value: "void" }
+          resources:
+            requests: { cpu: "2", memory: 4Gi }
+            limits: { memory: 4Gi }
+          volumeMounts:
+            - { name: hf, mountPath: /hf }
+            - { name: code, mountPath: /tp3, readOnly: true }
+      volumes:
+        # El worker lee los pesos de aqui (hostPath del disco local de nvidia-dgx); el head, por el NFS de este mismo directorio.
+        - name: hf
+          hostPath: { path: /home/dibanerz/.cache/huggingface, type: Directory }
+        - name: code
+          configMap: { name: qwen38fn-tp3 }
