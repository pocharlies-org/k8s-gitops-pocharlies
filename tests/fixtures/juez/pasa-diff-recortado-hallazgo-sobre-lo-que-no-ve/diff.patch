+def etiqueta_sin_ticket(n):
+    """Etiqueta de la PR no cita ningun ticket: icono ?? y el numero de PRs afectadas."""
+    return f'?? {n} PR' + ('s' if n != 1 else '')
+
+
+def resumen_sin_ticket(filas):
+    """Cuantas filas de la tabla tienen el veredicto `sin_ticket`."""
