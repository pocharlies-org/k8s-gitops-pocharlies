+#!/usr/bin/env python3
+"""Imprime la tabla de veredictos del juez de las ultimas PRs (SC-9003)."""
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+spec = importlib.util.spec_from_file_location('review_report_lib', Path(__file__).with_name('review_report_lib.py'))
+lib = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(lib)
+
+
+def main(entrada):
+    filas = [(p['repo'], str(p['pr']), p['veredicto']) for p in json.load(entrada)]
+    print(lib.render(filas), end='')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.stdin))
