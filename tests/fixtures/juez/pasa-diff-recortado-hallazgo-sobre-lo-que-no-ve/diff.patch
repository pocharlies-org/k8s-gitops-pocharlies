 """Utilidades de formato de los informes de review (SC-9003)."""
 
 ANCHO_MIN = 3
+
+def _celda(valor):
+    """Una celda de tabla Markdown: texto en una linea y con el `|` escapado."""
+    return str(valor if valor is not None else '').replace('\n', ' ').replace('|', '\\|')
+
+
+def _anchos(filas, cabecera):
+    """El ancho de cada columna: el de su celda mas larga, nunca menos que ANCHO_MIN."""
+    anchos = [max(ANCHO_MIN, len(_celda(c))) for c in cabecera]
+    for fila in filas:
+        for i, c in enumerate(fila):
+            anchos[i] = max(anchos[i], len(_celda(c)))
+    return anchos
+
+
+def render(filas, cabecera=("repo", "pr", "veredicto")):
+    """Tabla Markdown con las columnas alineadas. Sin filas, solo la cabecera."""
+    anchos = _anchos(filas, cabecera)
+    linea = lambda celdas: '| ' + ' | '.join(_celda(c).ljust(a) for c, a in zip(celdas, anchos)) + ' |'
+    sep = '| ' + ' | '.join('-' * a for a in anchos) + ' |'
+    return "\n".join([linea(cabecera), sep] + [linea(f) for f in filas]) + "\n"
+
+
+def etiqueta_pasa(n):
+    """Etiqueta de la PR cumple los criterios: icono OK y el numero de PRs afectadas."""
+    return f'OK {n} PR' + ('s' if n != 1 else '')
+
+
+def resumen_pasa(filas):
+    """Cuantas filas de la tabla tienen el veredicto `pasa`."""
+    return sum(1 for f in filas if f[2] == 'PASA')
+
+
+def etiqueta_no_pasa(n):
+    """Etiqueta de la PR no cumple algun criterio: icono NO y el numero de PRs afectadas."""
+    return f'NO {n} PR' + ('s' if n != 1 else '')
+
+
+def resumen_no_pasa(filas):
+    """Cuantas filas de la tabla tienen el veredicto `no_pasa`."""
+    return sum(1 for f in filas if f[2] == 'NO_PASA')
+
+
+def etiqueta_sin_veredicto(n):
+    """Etiqueta de el juez no pudo decidir: icono -- y el numero de PRs afectadas."""
+    return f'-- {n} PR' + ('s' if n != 1 else '')
+
+
+def resumen_sin_veredicto(filas):
+    """Cuantas filas de la tabla tienen el veredicto `sin_veredicto`."""
+    return sum(1 for f in filas if f[2] == 'SIN_VEREDICTO')
+
+
+def etiqueta_riesgo_alto(n):
+    """Etiqueta de la PR toca superficie de riesgo: icono !! y el numero de PRs afectadas."""
+    return f'!! {n} PR' + ('s' if n != 1 else '')
+
+
+def resumen_riesgo_alto(filas):
+    """Cuantas filas de la tabla tienen el veredicto `riesgo_alto`."""
+    return sum(1 for f in filas if f[2] == 'RIESGO_ALTO')
+
+
+def etiqueta_recortado(n):
+    """Etiqueta de el diff se recorto por el tope: icono <> y el numero de PRs afectadas."""
+    return f'<> {n} PR' + ('s' if n != 1 else '')
+
+
+def resumen_recortado(filas):
+    """Cuantas filas de la tabla tienen el veredicto `recortado`."""
+    return sum(1 for f in filas if f[2] == 'RECORTADO')
+
+
+def etiqueta_respaldo(n):
+    """Etiqueta de juzgo el modelo de respaldo: icono R2 y el numero de PRs afectadas."""
+    return f'R2 {n} PR' + ('s' if n != 1 else '')
+
+
+def resumen_respaldo(filas):
+    """Cuantas filas de la tabla tienen el veredicto `respaldo`."""
+    return sum(1 for f in filas if f[2] == 'RESPALDO')
+
