@@ -0,0 +1,28 @@
+import importlib.util
+import io
+import json
+import unittest
+from contextlib import redirect_stdout
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+spec = importlib.util.spec_from_file_location('pr_review_report', ROOT / 'scripts/pr-review-report.py')
+report = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(report)
+
+
+class TestInforme(unittest.TestCase):
+    def test_una_fila_por_pr(self):
+        entrada = io.StringIO(json.dumps([{'repo': 'o/r', 'pr': 7, 'veredicto': 'PASA'}]))
+        with redirect_stdout(io.StringIO()) as salida:
+            self.assertEqual(report.main(entrada), 0)
+        self.assertIn('| o/r', salida.getvalue())
+
+    def test_sin_prs_solo_sale_la_cabecera(self):
+        with redirect_stdout(io.StringIO()) as salida:
+            report.main(io.StringIO('[]'))
+        self.assertEqual(len(salida.getvalue().splitlines()), 2)
+
+
+if __name__ == '__main__':
+    unittest.main()
